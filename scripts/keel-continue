#!/bin/bash
#
# keel-continue — the ONLY thing in this project that may open the next chat.
# Contract: Keel's references/project-state.md, "scripts/keel-continue" and
# "What may stop a chain". It detects the tool this session runs in, sources
# that tool's row (scripts/keel-tools/<tool>.sh) and either fires the action
# the row performs, ONCE, or prints the continuation prompt to be pasted.
#
# This script carries no per-tool fact: no tool name, no launch command, no
# flag. Everything that differs between assistants is a field or a function
# of the row. (History kept in comments only: the measured launch traps —
# an interpolated Terminal string, a mktemp template with a suffix, the
# hand-off's raw content passed as an argument — live where the launch now
# lives, in the row.)
#
# Invoked from exactly two places: the session close-out (scripts/keel-close
# step 6) and rule 4 of scripts/keel-stop-hook. Never hand-composed, never
# retried.
#
# Usage:
#   scripts/keel-continue                 the real thing
#   scripts/keel-continue --smoke <nonce> used ONLY by `keel-chain-check
#                                         --smoke`: fires the row's action with
#                                         a marker payload, in a dedicated smoke
#                                         namespace — no hand-off, no lane, no
#                                         circuit breaker, no real receipt
#
# What may stop it is a CLOSED list (the DEGRADE/TERMINAL table):
#   DEGRADE  (fires anyway, on docs/PROGRESS.md, and says so):
#            hand-off missing / stale / malformed / `Handover: blocked`;
#            `Chaining model:` absent from the card (fires without a model).
#   TERMINAL (prints the prompt, fires nothing):
#            containment or `Repo:` fails; tree dirty; docs/PROGRESS.md absent;
#            no VERIFIED action for the detected tool; the tool's command not
#            on PATH; launch receipt already claimed; this session's
#            fire-ledger entry already claimed; lane busy; circuit breaker.
# Plus the two cases that are not stops at all, only "nothing to open here":
# a card that says off/supervised, and an unrecognised tool. Both print.
#
# Output always ends with one machine-readable line:
#   RESULT: FIRED | FIRED-DEGRADED (<why>) | PRINTED (<row>)
# Exit 0 on every path that leaves the user with an opened chat or a printed
# prompt. Non-zero only when it could do neither.

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
	echo "Not inside a git repository — cannot continue."
	exit 1
fi
cd "$REPO_ROOT" || exit 1

SCRIPT_DIR="$REPO_ROOT/scripts"
HANDOFF="$REPO_ROOT/docs/continuation-prompt.md"
PROGRESS="$REPO_ROOT/docs/PROGRESS.md"
STATE_ROOT="${KEEL_STATE_DIR:-${TMPDIR:-/tmp}}"
STATE_ROOT="${STATE_ROOT%/}"
RECEIPT_ROOT="$STATE_ROOT/keel-receipts"
LEDGER_ROOT="$STATE_ROOT/keel-state"

SMOKE_NONCE=""
case "${1:-}" in
--smoke)
	SMOKE_NONCE="${2:-}"
	case "$SMOKE_NONCE" in
	"" | *[!A-Za-z0-9-]*)
		echo "--smoke needs a nonce made of letters, digits and '-' (it is generated by scripts/keel-chain-check)."
		exit 2
		;;
	esac
	;;
"") ;;
*)
	echo "Unknown option '$1' — usage: keel-continue [--smoke <nonce>]"
	exit 2
	;;
esac

sha256_of() {
	printf '%s' "$1" | shasum -a 256 2>/dev/null | awk '{print $1}'
}

card_line() {
	[ -f "$PROGRESS" ] || return 0
	grep -m1 -E "^- $1:" "$PROGRESS" | sed -E "s/^- $1:[[:space:]]*//"
}

card_word() {
	card_line "$1" | awk '{print $1}' | tr -d '`*' | sed -E 's/[.,;]+$//'
}

handoff_body() {
	awk '/^---$/{n++; next} n>=2{print}' "$HANDOFF" 2>/dev/null
}

# Which authority the printed prompt points at. The hand-off keeps it only
# while it is clean; in every other state the committed files have it.
HANDOFF_STATE="unknown"
FALLBACK_PROMPT="Read $PROGRESS and continue."

# print_prompt <row> <reason> — the universal fallback: say why nothing
# opened, then show the prompt, ready to copy.
print_prompt() {
	echo "PRINTED — $2"
	echo "NOTIFY: no chat was opened ($1): $2"
	echo
	echo "--- Paste this into a new chat to continue ---"
	if [ "$HANDOFF_STATE" = "clean" ] && [ -n "$(handoff_body)" ]; then
		handoff_body
	elif [ "$HANDOFF_STATE" = "unknown" ] && [ -f "$HANDOFF" ] && [ -n "$(handoff_body)" ]; then
		handoff_body
	else
		echo "$FALLBACK_PROMPT"
	fi
	echo "--- end of prompt ---"
	echo "RESULT: PRINTED ($1)"
	exit 0
}

# --- Who am I ---------------------------------------------------------------
if [ -f "$SCRIPT_DIR/keel-session-pid.sh" ]; then
	# shellcheck source=scripts/keel-session-pid.sh
	. "$SCRIPT_DIR/keel-session-pid.sh"
	SESSION_ID=$(keel_session_pid)
	SESSION_RC=$?
else
	SESSION_ID="$PPID-unknown"
	SESSION_RC=1
fi
REPO_KEY=$(sha256_of "$REPO_ROOT")

# --- The fallback authority must exist --------------------------------------
if [ -z "$SMOKE_NONCE" ] && [ ! -f "$PROGRESS" ]; then
	FALLBACK_PROMPT="(docs/PROGRESS.md is absent — there is no committed state to resume from in $REPO_ROOT)"
	print_prompt "progress-absent" "docs/PROGRESS.md is absent: there is nothing left to degrade TO."
fi

# --- The card's Chaining: value ----------------------------------------------
CARD_CHAINING=$(card_word "Chaining")
if [ -z "$SMOKE_NONCE" ]; then
	case "$CARD_CHAINING" in
	prefill | start) ;;
	off | supervised)
		print_prompt "card-$CARD_CHAINING" "the card says Chaining: $CARD_CHAINING, so nothing opens automatically. The hand-off is ready."
		;;
	*)
		print_prompt "card-unreadable" "the card's 'Chaining:' line is missing or unreadable (read: '${CARD_CHAINING}'), so nothing opens automatically."
		;;
	esac
fi

# --- Detect the tool by asking each row's own keel_tool_detect ---------------
# No row, no detection, or a row that is not VERIFIED -> print. That is a
# success, and it is NEVER a fall-through to another tool's row (point 4a).
TOOL_ROW=""
for _row in "$SCRIPT_DIR"/keel-tools/*.sh; do
	[ -f "$_row" ] || continue
	_name=$( (
		. "$_row" >/dev/null 2>&1
		keel_tool_detect 2>/dev/null
	) 2>/dev/null)
	if [ -n "$_name" ]; then
		TOOL_ROW="$_row"
		break
	fi
done
if [ -z "$TOOL_ROW" ]; then
	print_prompt "no-tool-row" "no tool row in scripts/keel-tools/ recognises this environment, so there is no recorded action to fire."
fi

KEEL_TOOL_NAME="" KEEL_TOOL_EVIDENCE="" KEEL_TOOL_TIER="" KEEL_TOOL_CLI="" KEEL_TOOL_PASS_MODEL=""
# shellcheck disable=SC1090
. "$TOOL_ROW"
if [ -z "$KEEL_TOOL_NAME" ] || [ -z "$KEEL_TOOL_EVIDENCE" ] || [ -z "$KEEL_TOOL_TIER" ] || [ -z "$KEEL_TOOL_PASS_MODEL" ]; then
	print_prompt "row-incomplete" "the row $TOOL_ROW does not declare every field (name, evidence, tier, pass-model): an unfinished row never fires."
fi
if ! type keel_tool_launch >/dev/null 2>&1; then
	print_prompt "row-incomplete" "the row $TOOL_ROW defines no keel_tool_launch."
fi

# Live re-check of the row's own command and of whatever else its action
# needs (point 5a) — on the row's value, never on a literal.
capability_missing() {
	if [ -n "$KEEL_TOOL_CLI" ] && ! command -v "$KEEL_TOOL_CLI" >/dev/null 2>&1; then
		echo "'$KEEL_TOOL_CLI' is not on PATH in this shell (PATH=$PATH)"
		return 0
	fi
	if type keel_tool_preflight >/dev/null 2>&1; then
		_pre=$(keel_tool_preflight 2>&1) || {
			echo "$_pre"
			return 0
		}
	fi
	return 1
}

# The card's model, passed only to a row that accepts it (point 5b).
CARD_MODEL=$(card_word "Chaining model")
MODEL=""
MODEL_NOTE=""
case "$CARD_MODEL" in
"" | n/a | N/A | "[the")
	CARD_MODEL=""
	;;
esac
if [ "$KEEL_TOOL_PASS_MODEL" = "yes" ]; then
	if [ -n "$CARD_MODEL" ]; then
		MODEL="$CARD_MODEL"
		MODEL_NOTE="model: $MODEL (the card's 'Chaining model:')"
	else
		MODEL_NOTE="DEGRADED: the card has no usable 'Chaining model:' line, so the launch carries NO model flag and the next chat resolves its model from settings — add the line to docs/PROGRESS.md"
	fi
else
	MODEL_NOTE="the $KEEL_TOOL_NAME row does not accept the card's model (KEEL_TOOL_PASS_MODEL=$KEEL_TOOL_PASS_MODEL): the next chat runs on that tool's own configured default"
fi

# =============================================================================
# Smoke mode — the launch path proven, nothing real consumed.
# =============================================================================
if [ -n "$SMOKE_NONCE" ]; then
	if [ "$KEEL_TOOL_TIER" != "start" ]; then
		echo "SMOKE: the $KEEL_TOOL_NAME row's tier here is '$KEEL_TOOL_TIER'; only a 'start' action can be read back."
		echo "RESULT: PRINTED (smoke-no-start-action)"
		exit 0
	fi
	if _missing=$(capability_missing); then
		echo "SMOKE: missing capability — $_missing"
		echo "RESULT: PRINTED (capability-missing)"
		exit 0
	fi
	SMOKE_DIR="$LEDGER_ROOT/smoke/$SMOKE_NONCE"
	mkdir -p "$SMOKE_DIR" 2>/dev/null
	SMOKE_ENTRY="$SMOKE_DIR/fired-$REPO_KEY-$SESSION_ID"
	if ! mkdir "$SMOKE_ENTRY" 2>/dev/null; then
		echo "This session has already fired — brake: the session fire ledger (smoke namespace), entry $SMOKE_ENTRY. Nothing was opened."
		echo "RESULT: PRINTED (ledger-claimed)"
		exit 0
	fi
	if ! mkdir "$SMOKE_DIR/receipt" 2>/dev/null; then
		echo "This smoke launch was already claimed — brake: the launch receipt (smoke namespace), $SMOKE_DIR/receipt. Nothing was opened."
		echo "RESULT: PRINTED (receipt-claimed)"
		exit 0
	fi
	echo "$SESSION_ID" >"$SMOKE_DIR/receipt/launcher-pid"
	echo "SMOKE: firing the $KEEL_TOOL_NAME row's action with a marker payload ($MODEL_NOTE)."
	KEEL_SMOKE_NONCE="$SMOKE_NONCE"
	KEEL_SMOKE_DIR="$SMOKE_DIR"
	export KEEL_SMOKE_NONCE KEEL_SMOKE_DIR
	if keel_tool_launch "$REPO_ROOT" "keel smoke test $SMOKE_NONCE" "$MODEL"; then
		echo "RESULT: FIRED (smoke)"
	else
		echo "SMOKE: the launch action returned non-zero. Not retried."
		echo "RESULT: PRINTED (launch-failed)"
	fi
	exit 0
fi

# --- Evidence and tier -------------------------------------------------------
if [ "$KEEL_TOOL_EVIDENCE" != "VERIFIED" ]; then
	print_prompt "no-verified-action" "the $KEEL_TOOL_NAME row's evidence is '$KEEL_TOOL_EVIDENCE', not VERIFIED: only an action observed on a real machine is ever fired."
fi
# Downgrade to what the card allows, never upgrade; and never substitute
# another tier's action for the one the row has (point 5).
if [ "$KEEL_TOOL_TIER" != "start" ] && [ "$KEEL_TOOL_TIER" != "prefill" ]; then
	print_prompt "no-verified-action" "the $KEEL_TOOL_NAME row has no chaining action here (tier '$KEEL_TOOL_TIER')."
fi
if [ "$KEEL_TOOL_TIER" = "start" ] && [ "$CARD_CHAINING" = "prefill" ]; then
	print_prompt "no-action-at-tier" "the $KEEL_TOOL_NAME row's only action here is 'start', and the card allows 'prefill' at most: the row has no action at that tier."
fi
EFFECTIVE_TIER="$KEEL_TOOL_TIER"

# --- Verify BEFORE firing — by running the verifier, read ROW BY ROW ---------
# Identity rows (containment, Repo) and a dirty tree are TERMINAL. Freshness
# rows DEGRADE: the courier loses its authority, the work keeps its
# continuation.
if [ ! -x "$SCRIPT_DIR/keel-handoff-verify" ]; then
	print_prompt "verifier-absent" "scripts/keel-handoff-verify is absent or not executable: a chain whose verifier is missing cannot fire."
fi

DEGRADE_WHY=""
BLOCK_REASON=""
VERIFY_OUT=""
if [ ! -f "$HANDOFF" ]; then
	HANDOFF_STATE="missing"
	DEGRADE_WHY="hand-off missing"
else
	VERIFY_OUT=$("$SCRIPT_DIR/keel-handoff-verify" --no-lane 2>&1)
	if printf '%s\n' "$VERIFY_OUT" | grep -q '^Containment: FAIL'; then
		HANDOFF_STATE="foreign"
		print_prompt "containment" "containment failed — this hand-off belongs to another working directory. $(printf '%s\n' "$VERIFY_OUT" | grep -m1 '^Containment: FAIL')"
	fi
	HEADER=$(awk '/^---$/{n++; next} n==1{print} n>=2{exit}' "$HANDOFF" 2>/dev/null)
	HDR_REPO=$(printf '%s\n' "$HEADER" | grep -m1 '^Repo:' | sed -E 's/^Repo:[[:space:]]*//')
	HDR_COMMIT=$(printf '%s\n' "$HEADER" | grep -m1 '^Commit:' | sed -E 's/^Commit:[[:space:]]*//')
	HDR_GENERATED=$(printf '%s\n' "$HEADER" | grep -m1 '^Generated:' | sed -E 's/^Generated:[[:space:]]*//')
	HDR_TREE=$(printf '%s\n' "$HEADER" | grep -m1 '^Tree:' | sed -E 's/^Tree:[[:space:]]*//')
	HDR_HANDOVER=$(printf '%s\n' "$HEADER" | grep -m1 '^Handover:' | sed -E 's/^Handover:[[:space:]]*//')
	if [ -z "$HDR_REPO" ] || [ -z "$HDR_COMMIT" ] || [ -z "$HDR_GENERATED" ] || [ -z "$HDR_TREE" ]; then
		# An unparseable courier is an absent courier.
		HANDOFF_STATE="malformed"
		DEGRADE_WHY="hand-off unreadable (malformed header)"
	elif printf '%s\n' "$VERIFY_OUT" | grep -q '^Repo: FAIL'; then
		HANDOFF_STATE="foreign"
		print_prompt "repo" "'Repo:' disagrees — this hand-off belongs to another repository. $(printf '%s\n' "$VERIFY_OUT" | grep -m1 '^Repo: FAIL')"
	elif printf '%s\n' "$VERIFY_OUT" | grep -Eq '^(Commit|Generated|Tree|Branch): FAIL'; then
		HANDOFF_STATE="stale"
		DEGRADE_WHY="hand-off stale ($(printf '%s\n' "$VERIFY_OUT" | grep -E '^(Commit|Generated|Tree|Branch): FAIL' | sed -E 's/ —.*//' | tr '\n' ' ' | sed 's/ $//'))"
	elif ! printf '%s\n' "$VERIFY_OUT" | grep -q '^VERDICT: CONTINUE$'; then
		HANDOFF_STATE="malformed"
		DEGRADE_WHY="hand-off unreadable (the verifier returned no CONTINUE verdict)"
	else
		case "$HDR_HANDOVER" in
		clean)
			HANDOFF_STATE="clean"
			;;
		*)
			HANDOFF_STATE="blocked"
			BLOCK_REASON="${HDR_HANDOVER#blocked:}"
			BLOCK_REASON=$(printf '%s' "$BLOCK_REASON" | sed -e 's/^[[:space:]]*//')
			DEGRADE_WHY="Handover: blocked (${BLOCK_REASON:-no reason given})"
			;;
		esac
	fi
fi

# --- Tree dirty: TERMINAL on every path --------------------------------------
PORCELAIN=$(git status --porcelain 2>/dev/null)
if [ -n "$PORCELAIN" ]; then
	print_prompt "tree-dirty" "the working tree has uncommitted work, and a second session on top of it is how work gets lost. Commit first. Files:
$(printf '%s\n' "$PORCELAIN" | head -20)"
fi

# --- Missing capability: TERMINAL --------------------------------------------
if _missing=$(capability_missing); then
	print_prompt "capability-missing" "missing capability — $_missing. Nothing can be launched from here."
fi

# --- Lane busy: TERMINAL ------------------------------------------------------
LANE_OUT=$("$SCRIPT_DIR/keel-handoff-verify" --lane 2>&1)
if printf '%s\n' "$LANE_OUT" | grep -q '^Lane: BUSY'; then
	print_prompt "lane-busy" "another live session holds this checkout's single lane. $LANE_OUT"
fi

# --- This session's fire-ledger entry: TERMINAL -------------------------------
LEDGER_ENTRY="$LEDGER_ROOT/fired-$REPO_KEY-$SESSION_ID"
if [ -d "$LEDGER_ENTRY" ]; then
	print_prompt "ledger-claimed" "this SESSION has already fired — brake: the session fire ledger, entry $LEDGER_ENTRY. One session opens one chat, whatever became of the hand-off."
fi

# --- Circuit breaker: TERMINAL ------------------------------------------------
mkdir -p "$RECEIPT_ROOT" "$LEDGER_ROOT" 2>/dev/null
COUNTER_FILE="$RECEIPT_ROOT/$REPO_KEY.count"
NOW_EPOCH=$(date +%s)
RECENT=0
if [ -f "$COUNTER_FILE" ]; then
	while IFS= read -r _ts; do
		case "$_ts" in
		"" | *[!0-9]*) continue ;;
		esac
		[ $((NOW_EPOCH - _ts)) -lt 3600 ] && RECENT=$((RECENT + 1))
	done <"$COUNTER_FILE"
fi
if [ "$RECENT" -ge 3 ]; then
	print_prompt "circuit-breaker" "$RECENT launches already fired for this repository in the last hour — something is re-running a close-out. Chaining is disabled for this session."
fi

# --- The prompt, and the receipt's identity -----------------------------------
HEAD_FULL=$(git rev-parse HEAD 2>/dev/null)
if [ "$HANDOFF_STATE" = "clean" ]; then
	PROMPT_TEXT="Read $HANDOFF and continue."
	RECEIPT_ID="${HDR_GENERATED}${HDR_COMMIT}"
	RECEIPT_KIND="hand-off (Generated=$HDR_GENERATED, Commit=$HDR_COMMIT)"
else
	PROMPT_TEXT="Read $PROGRESS and continue."
	if [ "$HANDOFF_STATE" = "blocked" ]; then
		PROMPT_TEXT="Read $PROGRESS and continue. The previous session handed over blocked: ${BLOCK_REASON:-no reason given}. Work what does NOT depend on that block."
	fi
	RECEIPT_ID="degraded:${REPO_KEY}:${HEAD_FULL}"
	RECEIPT_KIND="degraded (repository + HEAD $HEAD_FULL)"
fi
FALLBACK_PROMPT="$PROMPT_TEXT"
RECEIPT_KEY=$(sha256_of "$RECEIPT_ID")
RECEIPT_DIR="$RECEIPT_ROOT/$RECEIPT_KEY"

# --- Claim BOTH brakes atomically (mkdir), record who fired, then fire ONCE ---
if ! mkdir "$LEDGER_ENTRY" 2>/dev/null; then
	print_prompt "ledger-claimed" "this SESSION has already fired — brake: the session fire ledger, entry $LEDGER_ENTRY."
fi
{
	echo "session=$SESSION_ID"
	echo "claimed_at=$NOW_EPOCH"
	echo "head=$HEAD_FULL"
	echo "receipt=$RECEIPT_KEY"
	echo "handoff_state=$HANDOFF_STATE"
} >"$LEDGER_ENTRY/info" 2>/dev/null
if ! mkdir "$RECEIPT_DIR" 2>/dev/null; then
	print_prompt "receipt-claimed" "this continuation has already been launched — brake: the launch receipt, $RECEIPT_KIND, at $RECEIPT_DIR. Firing again would open a second window."
fi
echo "$SESSION_ID" >"$RECEIPT_DIR/launcher-pid"
echo "$NOW_EPOCH" >>"$COUNTER_FILE"

if [ "$SESSION_RC" -ne 0 ]; then
	echo "NOTE: this session's identity could not be established from the process tree (no tool row matched an ancestor); the fire ledger entry is keyed to the parent process and may not protect a later attempt. The launch receipt still does."
fi

# --- Hand the lane back IMMEDIATELY BEFORE firing -----------------------------
"$SCRIPT_DIR/keel-handoff-verify" --release
if keel_tool_launch "$REPO_ROOT" "$PROMPT_TEXT" "$MODEL"; then
	LAUNCH_RC=0
else
	LAUNCH_RC=1
fi

if [ "$LAUNCH_RC" -ne 0 ]; then
	print_prompt "launch-failed" "the $KEEL_TOOL_NAME row's launch action returned non-zero, so whether a window appeared is unknown. It is NEVER fired again: this session's chaining is spent."
fi

echo "Receipt: $RECEIPT_KIND -> $RECEIPT_DIR"
echo "Ledger:  $LEDGER_ENTRY"
echo "Launch:  $KEEL_TOOL_NAME row, tier $EFFECTIVE_TIER; $MODEL_NOTE"
echo "Prompt:  $PROMPT_TEXT"
if [ "$EFFECTIVE_TIER" = "prefill" ]; then
	_what="Opened a pre-filled chat; press Enter there to continue."
else
	_what="Opened a new terminal session in $REPO_ROOT and started the next chat. If the single lane turns out to be busy, that window says so and prints the prompt instead."
fi
if [ -n "$DEGRADE_WHY" ]; then
	echo "FIRED (DEGRADED: $DEGRADE_WHY) — the hand-off lost its authority, so the next chat was started on docs/PROGRESS.md, the committed state. $_what"
	echo "NOTIFY: the chain fired DEGRADED ($DEGRADE_WHY)."
	echo "RESULT: FIRED-DEGRADED ($DEGRADE_WHY)"
else
	echo "FIRED — $_what"
	echo "RESULT: FIRED"
fi
exit 0
