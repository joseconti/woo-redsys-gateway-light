# === 21. Recorded negatives ==================================================
section("Every recorded negative carries its scope")
NEGATIVE = re.compile(r"\bcannot\b|there is no\b|not possible|\bimpossible\b|does not support", re.I)
if not decisions_text:
    na("%s does not exist" % DECISIONS)
else:
    entries, current = [], None
    for lineno, line in enumerate(decisions_text.split("\n"), 1):
        head = re.match(r"^## (D-\d+)\b", line)
        if head:
            current = {"id": head.group(1), "line": lineno, "hits": [], "scoped": False}
            entries.append(current)
        elif current is not None:
            if re.match(r"^\s*[-*]?\s*\**Not checked:\**\s*\S", line):
                current["scoped"] = True
            elif NEGATIVE.search(line):
                current["hits"].append((lineno, NEGATIVE.search(line).group(0)))
        if head and NEGATIVE.search(line):
            current["hits"].append((lineno, NEGATIVE.search(line).group(0)))
    negatives = [e for e in entries if e["hits"]]
    bad = 0
    for entry in negatives:
        if not entry["scoped"]:
            fail("%s:%d %s asserts an impossibility ('%s', line %d) and carries no `Not checked:` line"
                 % (DECISIONS, entry["line"], entry["id"], entry["hits"][0][1], entry["hits"][0][0]))
            bad += 1
    if not bad:
        ok("%d entries; %d assert an impossibility and each carries a `Not checked:` line"
           % (len(entries), len(negatives)))

# === 22-24. The sprint plan ==================================================
STATUS = ["not-started", "in-progress", "done", "dropped"]
SOURCES = ["measured", "estimated"]


def scalar(value):
    value = value.strip()
    if value.startswith("[") and value.endswith("]"):
        return [x.strip().strip("'\"") for x in value[1:-1].split(",") if x.strip()]
    if value in ("null", "~", ""):
        return None
    if (value[:1] == value[-1:]) and value[:1] in "'\"" and len(value) > 1:
        return value[1:-1]
    try:
        return float(value)
    except ValueError:
        return value


def frontmatter(path):
    lines = (read(path) or "").split("\n")
    if not lines or lines[0].strip() != "---":
        return None
    try:
        end = lines.index("---", 1)
    except ValueError:
        return None
    top, items, current = {}, [], None
    for index in range(1, end):
        raw = lines[index]
        text = re.sub(r"\s+#.*$", "", raw)
        match = re.match(r"^(\s*)(- )?([A-Za-z_]+):\s*(.*)$", text)
        if not match:
            continue
        indent, dash, key, value = match.groups()
        if dash:
            current = {"_line": index + 1, "_raw": raw}
            items.append(current)
        elif not indent:
            top[key] = (scalar(value), index + 1)
            current = None
            continue
        if current is not None:
            current[key] = scalar(value)
            current["_l_" + key] = index + 1
            current["_raw"] += "\n" + raw
    return {"top": top, "items": items, "body": "\n".join(lines[end + 1:])}


sprints_line = card("Sprints")
sprints_mode = (sprints_line or "").split()[0].strip("`") if sprints_line else None
sprint_files = sorted(glob.glob("docs/sprints/sprint-*.md"),
                      key=lambda p: int(re.search(r"sprint-(\d+)", p).group(1)) if re.search(r"sprint-(\d+)", p) else 0)
DEFERRED = "docs/sprints/deferred.md"
PLANJSON = "docs/.keel/plan.json"
plan_off = sprints_mode == "off" and bool(real_decisions(sprints_line))
slices, deferred_items, sprint_meta = [], [], []
for path in sprint_files:
    data = frontmatter(path)
    number_match = re.search(r"sprint-(\d+)", path)
    order = int(number_match.group(1))
    sprint_meta.append((path, order, data))
    if data:
        for item in data["items"]:
            item["_file"], item["_sprint"], item["_body"] = path, order, data["body"]
            slices.append(item)
deferred_data = frontmatter(DEFERRED) if os.path.isfile(DEFERRED) else None
if deferred_data:
    for item in deferred_data["items"]:
        item["_file"], item["_sprint"] = DEFERRED, None
        deferred_items.append(item)


def where(item, key=None):
    return "%s:%d" % (item["_file"], item.get("_l_" + key, item["_line"]) if key else item["_line"])


def is_num(value):
    return isinstance(value, float)


section("The sprint plan is well-formed")
if plan_off:
    na("the card says `Sprints: off` (%s) — the plan checks are skipped" % ", ".join(real_decisions(sprints_line)))
elif not sprint_files:
    na("no docs/sprints/sprint-<N>.md exists — nothing to parse (check 23 fails on the missing plan)")
else:
    bad = 0
    for path, order, data in sprint_meta:
        if data is None:
            fail("%s:1 has no frontmatter block" % path)
            bad += 1
            continue
        schema = data["top"].get("schema", (None, 1))
        if schema[0] != "keel.sprint/1":
            fail("%s:%d schema is '%s', expected keel.sprint/1" % (path, schema[1], schema[0]))
            bad += 1
        status = data["top"].get("status", (None, 1))
        if status[0] not in STATUS:
            fail("%s:%d sprint status '%s' is outside the enum (%s)" % (path, status[1], status[0], " | ".join(STATUS)))
            bad += 1
    if os.path.isfile(DEFERRED) and deferred_data is None:
        fail("%s:1 has no frontmatter block" % DEFERRED)
        bad += 1
    seen = {}
    for item in slices + deferred_items:
        ident = item.get("id")
        if not ident:
            fail("%s item has no id" % where(item))
            bad += 1
            continue
        if item.get("status") not in STATUS:
            fail("%s %s status '%s' is outside the enum (%s)" % (where(item, "status"), ident, item.get("status"),
                                                                 " | ".join(STATUS)))
            bad += 1
        if not is_num(item.get("hours")):
            fail("%s %s hours '%s' is not a number" % (where(item, "hours"), ident, item.get("hours")))
            bad += 1
        if ident in seen:
            fail("%s id %s is already used at %s" % (where(item, "id"), ident, seen[ident]))
            bad += 1
        else:
            seen[ident] = where(item, "id")
    home = {}
    for item in slices:
        home.setdefault(item.get("id"), item["_sprint"])
    deferred_ids = set(i.get("id") for i in deferred_items)
    for item in slices + deferred_items:
        deps = item.get("depends_on") or []
        if not isinstance(deps, list):
            fail("%s %s depends_on is not a list of ids" % (where(item, "depends_on"), item.get("id")))
            bad += 1
            continue
        for dep in deps:
            if dep in deferred_ids and item["_sprint"] is not None:
                fail("%s %s depends on %s, which is still in %s" % (where(item, "depends_on"), item.get("id"), dep,
                                                                    DEFERRED))
                bad += 1
            elif dep not in home and dep not in deferred_ids:
                fail("%s %s depends on %s, which does not exist" % (where(item, "depends_on"), item.get("id"), dep))
                bad += 1
            elif item["_sprint"] is not None and dep in home and home[dep] > item["_sprint"]:
                fail("%s %s (sprint %d) depends on %s, which is in the LATER sprint %d"
                     % (where(item, "depends_on"), item.get("id"), item["_sprint"], dep, home[dep]))
                bad += 1
    for item in slices:
        if item.get("status") == "dropped":
            cited = real_decisions(item["_raw"]) or real_decisions(
                "\n".join(l for l in item["_body"].split("\n") if item.get("id") and item["id"] in l))
            if not cited:
                fail("%s %s is `dropped` and neither its entry nor the sprint body cites a recorded decision"
                     % (where(item, "status"), item.get("id")))
                bad += 1
    rc, history, _ = git("log", "--format=", "-p", "--unified=0", "--", "docs/sprints")
    ever = set(re.findall(r"^[+-]\s+- id:\s*([A-Za-z]+-\d+)", history, re.M))
    for ident in sorted(ever - set(seen)):
        fail("docs/sprints/: %s was in the plan in git history and is now in no sprint file and not in %s — "
             "a slice leaves a sprint by moving to deferred.md or by `status: dropped` with its decision"
             % (ident, DEFERRED))
        bad += 1
    if not os.path.isfile("scripts/keel-plan"):
        fail("scripts/keel-plan does not exist — docs/.keel/plan.json cannot be compared with its sources")
        bad += 1
    else:
        rc, out, err = run(["/bin/bash", "scripts/keel-plan", "check"])
        if rc != 0:
            for line in (out + err).strip().split("\n")[:12]:
                fail("scripts/keel-plan check (exit %d): %s" % (rc, line))
            bad += 1
    estimate = read("docs/estimate.md")
    total = sum(i["hours"] for i in slices if is_num(i.get("hours")) and i.get("status") != "dropped")
    if estimate is None:
        na("docs/estimate.md does not exist — no Phase 5 line to compare with the plan's %g h" % total)
    else:
        match = re.search(r"^[-*]?\s*\**Phase 5 hours:\**\s*([0-9.]+)\s*h", estimate, re.M)
        lineno = estimate[:match.start()].count("\n") + 1 if match else 1
        if not match:
            fail("docs/estimate.md: no `Phase 5 hours: <n> h` line")
            bad += 1
        elif abs(float(match.group(1)) - total) > 0.005:
            fail("docs/estimate.md:%d Phase 5 hours is %s h; the plan's slice hours sum to %g h"
                 % (lineno, match.group(1), total))
            bad += 1
    if not bad:
        ok("%d sprint files, %d slices, %d deferred items: statuses in the enum, ids unique, every depends_on "
           "resolves to the same or an earlier sprint, plan.json matches its sources, the estimate's Phase 5 "
           "hours equal the plan's (%g h), no slice left without a trace"
           % (len(sprint_files), len(slices), len(deferred_items), total))

section("The plan is not behind the work")
BOOKKEEPING = ["docs/sprints", "docs/.keel", "docs/PROGRESS.md", "docs/sessions.md", "docs/token-ledger.md"]
if sprints_line is None:
    fail("%s: the project card has no `Sprints:` line" % PROGRESS)
elif sprints_mode == "off" and not plan_off:
    fail("%s: the card says `Sprints: off` but cites no decision recorded in %s" % (PROGRESS, DECISIONS))
elif plan_off:
    na("the card says `Sprints: off` (%s)" % ", ".join(real_decisions(sprints_line)))
else:
    ok("the card carries `Sprints: %s`" % sprints_mode)
    if not sprint_files:
        fail("docs/sprints/ holds no sprint-<N>.md — work with no plan")
    else:
        ok("%d sprint file(s) exist" % len(sprint_files))
        work = ["."] + [":(exclude)" + p for p in BOOKKEEPING]
        newest_work = git("log", "-1", "--format=%H", "HEAD", "--", *work)[1].strip()
        newest_plan = git("log", "-1", "--format=%H", "HEAD", "--", "docs/sprints")[1].strip()
        if not newest_plan:
            fail("docs/sprints/ has never been committed — the plan accounts for none of the history")
        elif not newest_work:
            ok("no commit touches a non-bookkeeping path")
        elif git("merge-base", "--is-ancestor", newest_work, newest_plan)[0] == 0:
            ok("ancestry: the newest work commit %s is an ancestor of (or is) the newest plan commit %s"
               % (newest_work[:7], newest_plan[:7]))
        else:
            behind = [l for l in git("log", "--format=%h %s", newest_plan + "..HEAD", "--", *work)[1].split("\n") if l]
            fail("the plan is behind the work: docs/sprints/ last changed in %s, and %d later commit(s) touch "
                 "non-bookkeeping paths: %s" % (newest_plan[:7], len(behind), "; ".join(behind[:8])))
        bad = 0
        for item in slices:
            if item.get("status") == "done" and not is_num(item.get("actual_hours")):
                fail("%s %s is `done` with actual_hours '%s' — not a number"
                     % (where(item, "actual_hours"), item.get("id"), item.get("actual_hours")))
                bad += 1
        if not bad:
            ok("every `done` slice carries a numeric actual_hours (%d slices)"
               % len([i for i in slices if i.get("status") == "done"]))
        open_ids = set(i.get("id") for i in slices if i.get("status") not in ("done", "dropped"))
        all_ids = set(i.get("id") for i in slices) | set(i.get("id") for i in deferred_items)
        position = re.search(r"^## Current position[^\n]*\n(.*?)(?=^## |\Z)", progress_text, re.M | re.S)
        pos_line = progress_text[:position.start()].count("\n") + 1 if position else 1
        named = re.findall(r"\bS-\d+\b", position.group(1)) if position else []
        if not position:
            fail("%s has no '## Current position' section" % PROGRESS)
        elif not open_ids:
            ok("every slice in the plan is closed — the position needs no open slice")
        else:
            unknown = sorted(set(n for n in named if n not in all_ids))
            for name in unknown:
                fail("%s:%d 'Current position' names %s, which is in no sprint file" % (PROGRESS, pos_line, name))
            if not [n for n in named if n in open_ids]:
                fail("%s:%d 'Current position' names no open slice (%d slices are open: %s)"
                     % (PROGRESS, pos_line, len(open_ids), ", ".join(sorted(open_ids))))
            elif not unknown:
                ok("'Current position' names the open slice %s" % next(n for n in named if n in open_ids))

section("Session time is measured, not typed")
SESSIONS = "docs/sessions.md"
COLUMNS = ["Start", "End", "Wall-clock h", "Paused h", "Planned (slices, est. h)", "Done", "Est. h", "Actual h",
           "Deviation h", "Not finished (h spent)", "Left after h", "Active h", "Pace factor", "Projected left h",
           "Notes"]
if plan_off:
    na("the card says `Sprints: off` (%s)" % ", ".join(real_decisions(sprints_line)))
else:
    bad = 0
    for item in slices + deferred_items:
        if "actual_source" in item and item.get("actual_source") not in SOURCES:
            fail("%s %s actual_source '%s' is neither measured nor estimated"
                 % (where(item, "actual_source"), item.get("id"), item.get("actual_source")))
            bad += 1
        elif item["_sprint"] is not None and "actual_source" not in item:
            fail("%s %s has no actual_source" % (where(item), item.get("id")))
            bad += 1
    if not bad:
        ok("every actual_source is `measured` or `estimated` (%d slices)" % len(slices))
    rows, sessions_table = [], None
    if read(SESSIONS) is None:
        fail("%s does not exist" % SESSIONS)
    else:
        found, orphan_rows = tables(SESSIONS)
        sessions_table = next((t for t in found if "Start" in t["header"] and "End" in t["header"]), None)
        for lineno, _ in orphan_rows:
            fail("%s:%d table row outside the sessions table" % (SESSIONS, lineno))
        if sessions_table is None:
            fail("%s has no sessions table (header starting `| Start | End |`)" % SESSIONS)
        elif sessions_table["header"] != COLUMNS:
            lacking = [c for c in COLUMNS if c not in sessions_table["header"]]
            fail("%s:%d the header is not the contract's fifteen columns%s"
                 % (SESSIONS, sessions_table["line"], (" — missing: " + ", ".join(lacking)) if lacking else
                    " (order or extra columns differ)"))
            sessions_table = None
        else:
            rows = sessions_table["rows"]
    if sessions_table is not None:
        done_listed = set()
        bad = 0
        for lineno, cells in rows:
            if len(cells) != len(COLUMNS):
                fail("%s:%d row has %d cells, the header has %d" % (SESSIONS, lineno, len(cells), len(COLUMNS)))
                bad += 1
                continue
            row = dict(zip(COLUMNS, cells))
            done_listed.update(re.findall(r"[A-Za-z]+-\d+", row["Done"]))
            notes = row["Notes"]
            legacy = "legacy" in notes.lower()
            try:
                begin, finish = datetime.fromisoformat(row["Start"]), datetime.fromisoformat(row["End"])
                if finish < begin:
                    fail("%s:%d End (%s) is before Start (%s)" % (SESSIONS, lineno, row["End"], row["Start"]))
                    bad += 1
            except (ValueError, TypeError):
                fail("%s:%d Start/End are not ISO timestamps comparable to each other ('%s', '%s')"
                     % (SESSIONS, lineno, row["Start"], row["End"]))
                bad += 1
            est, act, dev = number(row["Est. h"]), number(row["Actual h"]), number(row["Deviation h"])
            if None in (est, act, dev):
                fail("%s:%d Est. h / Actual h / Deviation h must be numbers ('%s', '%s', '%s')"
                     % (SESSIONS, lineno, row["Est. h"], row["Actual h"], row["Deviation h"]))
                bad += 1
            elif abs(dev - (act - est)) > 0.05:
                fail("%s:%d Deviation h is %g; Actual h %g minus Est. h %g is %g"
                     % (SESSIONS, lineno, dev, act, est, act - est))
                bad += 1
            if legacy:
                continue
            wall, paused, active = number(row["Wall-clock h"]), number(row["Paused h"]), number(row["Active h"])
            if None in (wall, paused, active):
                fail("%s:%d Wall-clock h / Paused h / Active h must be numbers on a non-legacy row ('%s', '%s', '%s')"
                     % (SESSIONS, lineno, row["Wall-clock h"], row["Paused h"], row["Active h"]))
                bad += 1
            elif abs(active - (wall - paused)) > 0.05:
                fail("%s:%d Active h is %g; Wall-clock h %g minus Paused h %g is %g"
                     % (SESSIONS, lineno, active, wall, paused, wall - paused))
                bad += 1
            left, factor, projected = number(row["Left after h"]), number(row["Pace factor"]), number(row["Projected left h"])
            reasoned = re.search(r"unavailable|no time plan|no work remains", notes, re.I)
            if left is None:
                fail("%s:%d Left after h must be a number on a non-legacy row ('%s')" % (SESSIONS, lineno, row["Left after h"]))
                bad += 1
            if (factor is None or projected is None) and not reasoned:
                fail("%s:%d Pace factor / Projected left h is unavailable ('%s', '%s') and Notes gives no reason"
                     % (SESSIONS, lineno, row["Pace factor"], row["Projected left h"]))
                bad += 1
            if projected is not None and left is not None:
                if factor is not None and abs(projected - left * factor) > 0.05:
                    fail("%s:%d Projected left h is %g; Left after h %g x Pace factor %g is %g"
                         % (SESSIONS, lineno, projected, left, factor, left * factor))
                    bad += 1
                elif factor is None and (projected != 0 or left != 0):
                    fail("%s:%d Projected left h is %g with no Pace factor — only 0 with nothing left is computable"
                         % (SESSIONS, lineno, projected))
                    bad += 1
        if not bad:
            if rows:
                ok("%s: %d row(s) — End not before Start, Deviation = Actual - Est., Active = Wall-clock - Paused, "
                   "projection = Left after x Pace factor (all within 0.05 h)" % (SESSIONS, len(rows)))
            else:
                ok("%s: the fifteen-column header is in place and the table has 0 rows, so there is no row "
                   "arithmetic to check yet (the first row is appended by `scripts/keel-time end`)" % SESSIONS)
        bad = 0
        for item in slices:
            if item.get("status") == "done" and item.get("actual_source") == "measured" and item.get("id") not in done_listed:
                fail("%s %s is `done` and `measured` but no %s row lists it in its Done column"
                     % (where(item, "actual_source"), item.get("id"), SESSIONS))
                bad += 1
        if not bad:
            ok("every `done` + `measured` slice is listed in a sessions row's Done column (%d such slices)"
               % len([i for i in slices if i.get("status") == "done" and i.get("actual_source") == "measured"]))
    # plan.json: factor and projection from the eligible sample
    plan_json = read(PLANJSON)
    if plan_json is None:
        fail("%s does not exist" % PLANJSON)
    else:
        try:
            plan_data = json.loads(plan_json)
        except ValueError:
            plan_data = None
            fail("%s is not valid JSON" % PLANJSON)
        if plan_data is not None:
            eligible = [i for i in slices if i.get("status") == "done" and i.get("actual_source") == "measured"
                        and is_num(i.get("hours")) and i["hours"] > 0
                        and is_num(i.get("actual_hours")) and i["actual_hours"] >= 0]
            factor = (sum(i["actual_hours"] for i in eligible) / sum(i["hours"] for i in eligible)) if eligible else None

            def expected(remaining):
                if remaining == 0:
                    return 0.0
                return None if factor is None else remaining * factor

            def same(got, want, tolerance):
                if got is None or want is None:
                    return got is None and want is None
                return isinstance(got, (int, float)) and abs(got - want) <= tolerance

            bad = 0
            totals = plan_data.get("totals") or {}
            remaining = sum(i["hours"] for i in slices if is_num(i.get("hours")) and i.get("status") not in ("done", "dropped"))
            if "pace_factor" not in totals or "projected_remaining_hours" not in totals:
                fail("%s totals carry no pace_factor / projected_remaining_hours" % PLANJSON)
                bad += 1
            else:
                if not same(totals["pace_factor"], factor, 1e-5):
                    fail("%s totals.pace_factor is %s; the %d eligible slices (done, measured, hours > 0) give %s"
                         % (PLANJSON, totals["pace_factor"], len(eligible), factor))
                    bad += 1
                if not same(totals["projected_remaining_hours"], expected(remaining), 1e-3):
                    fail("%s totals.projected_remaining_hours is %s; remaining %g h x factor %s gives %s"
                         % (PLANJSON, totals["projected_remaining_hours"], remaining, factor, expected(remaining)))
                    bad += 1
                sample = (totals.get("pace_sample") or {}).get("slices")
                if sample is not None and sample != len(eligible):
                    fail("%s totals.pace_sample.slices is %s; %d slices are eligible" % (PLANJSON, sample, len(eligible)))
                    bad += 1
            for sprint in plan_data.get("sprints") or []:
                own = [i for i in slices if i["_sprint"] == sprint.get("sprint")]
                left = sum(i["hours"] for i in own if is_num(i.get("hours")) and i.get("status") not in ("done", "dropped"))
                if "projected_remaining_hours" in sprint and not same(sprint["projected_remaining_hours"], expected(left), 1e-3):
                    fail("%s sprint %s projected_remaining_hours is %s; remaining %g h x plan-wide factor %s gives %s"
                         % (PLANJSON, sprint.get("sprint"), sprint["projected_remaining_hours"], left, factor, expected(left)))
                    bad += 1
            if not bad:
                ok("%s: pace factor %s from %d eligible slice(s), projections %s"
                   % (PLANJSON, "null" if factor is None else "%.6g" % factor, len(eligible),
                      "null where work remains (no measured completed work) and 0 where none does" if factor is None
                      else "equal remaining x factor"))
    ignore_lines = [l.strip() for l in (read(".gitignore") or "").split("\n")]
    if "docs/.keel/clock.jsonl" not in ignore_lines and "/docs/.keel/clock.jsonl" not in ignore_lines:
        fail(".gitignore does not carry docs/.keel/clock.jsonl")
    elif "docs/.keel/clock.jsonl" in TRACKED:
        fail("docs/.keel/clock.jsonl is tracked by git although .gitignore lists it — untrack it")
    else:
        ok(".gitignore carries docs/.keel/clock.jsonl and the file is not tracked")

# === 25. Test selection ======================================================
section("Test selection is wired and honest")
SELECTOR = "scripts/keel-affected-tests"
selector_text = read(SELECTOR)
for path in (SELECTOR, ".githooks/pre-push"):
    if not os.path.isfile(path):
        fail("%s does not exist" % path)
    elif not os.access(path, os.X_OK):
        fail("%s is not executable" % path)
    else:
        ok("%s exists and is executable" % path)
hooks_path = git("config", "--get", "core.hooksPath")[1].strip()
if hooks_path.rstrip("/") in (".githooks", os.path.join(ROOT, ".githooks")):
    ok("core.hooksPath is '%s'" % hooks_path)
else:
    fail("core.hooksPath is '%s', not .githooks — the pre-push hook never runs (fix: git config core.hooksPath .githooks)"
         % (hooks_path or "unset"))
widen_plan = re.search(r"^- \*\*Widening list.*$", plan_text or "", re.M)
widen_code = re.search(r"WIDEN_FULL=\$\(cat <<'EOF'\n(.*?)\nEOF", selector_text or "", re.S)
if selector_text is None:
    pass
elif not widen_plan:
    fail("%s: the 'Test selection' section has no 'Widening list' line" % PLAN)
elif not widen_code:
    fail("%s: no WIDEN_FULL table found" % SELECTOR)
else:
    plan_line = (plan_text or "")[:widen_plan.start()].count("\n") + 1
    declared = set(re.findall(r"`([^`]+)`", widen_plan.group(0)))
    coded = set(l.split("|")[0].strip() for l in widen_code.group(1).split("\n") if l.strip())
    code_lines = "\n".join(code_part(l) for l in selector_text.split("\n"))
    bad = 0
    for path in sorted(coded - declared):
        fail("%s widens on '%s', which %s:%d does not list" % (SELECTOR, path, PLAN, plan_line))
        bad += 1
    for path in sorted(declared - coded):
        if path.endswith("/") and (path + "*)") in code_lines:
            continue
        fail("%s:%d lists '%s' in the widening list, which %s does not widen on" % (PLAN, plan_line, path, SELECTOR))
        bad += 1
    if not bad:
        ok("the selector's widening list matches the technical plan's (%d paths)" % len(declared))
if tp_table is None or column(tp_table["header"], "Evidence") is None:
    na("%s has no test-point table with an Evidence column — no `scope:` line to look for" % TESTPOINTS)
else:
    evidence = column(tp_table["header"], "Evidence")
    red = column(tp_table["header"], "Red first")
    bad, legacy = 0, []
    for lineno, cells in tp_table.get("good", []):
        if "scope:" in cells[evidence]:
            continue
        if red is not None and cells[red].strip("` ") == RED[3]:
            legacy.append(lineno)
            continue
        fail("%s:%d the Evidence cell carries no `scope:` line" % (TESTPOINTS, lineno))
        bad += 1
    if not bad:
        ok("every test-point row written since the selector exists carries its `scope:` line (%d rows)"
           % (len(tp_table.get("good", [])) - len(legacy)))
    if legacy:
        info("%d row(s) marked `n/a %s predates` carry no `scope:` line — they were recorded before the "
             "selector existed (lines %s)" % (len(legacy), DASH, ", ".join(str(n) for n in legacy)))
if selector_text is not None:
    tmp = tempfile.mkdtemp(prefix="keel-verify-sel.")
    try:
        env = dict((k, v) for k, v in os.environ.items() if not k.startswith("GIT_"))
        clone = os.path.join(tmp, "repo")
        rc, _, err = run(["git", "clone", "-q", "--shared", ROOT, clone], env=env)
        if rc != 0:
            fail("the synthetic check could not build its throwaway repository: %s" % err.strip()[:160])
        else:
            shutil.copyfile(SELECTOR, os.path.join(clone, SELECTOR))
            if run(["git", "status", "--porcelain"], cwd=clone, env=env)[1].strip():
                run(["git", "-c", "user.name=keel-verify", "-c", "user.email=keel-verify@localhost", "commit", "-q",
                     "-a", "-m", "selector under test"], cwd=clone, env=env)
            synthetic = "includes/keel-verify-synthetic-source-no-test-covers.php"
            if not os.path.isdir(os.path.join(clone, "includes")):
                os.makedirs(os.path.join(clone, "includes"))
            with open(os.path.join(clone, synthetic), "w") as handle:
                handle.write("<?php\n// synthetic source file: no test covers it\n")
            rc, out, err = run(["/bin/bash", SELECTOR, "--base", "HEAD"], cwd=clone, env=env)
            scope = next((l for l in out.split("\n") if l.startswith("scope:")), "")
            count = re.search(r"(\d+) of \d+ tests", scope)
            if rc != 0:
                ok("synthetic uncovered source file: the selector FAILED (exit %d) rather than select nothing" % rc)
            elif count and int(count.group(1)) > 0 and "widened" in scope:
                ok("synthetic uncovered source file: the selector widened — %s" % scope)
            else:
                fail("synthetic uncovered source file (%s): the selector exited 0 without widening — '%s'"
                     % (synthetic, scope or out.strip().split("\n")[-1][:160]))
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

# === 26. Tool registry =======================================================
section("The tool registry is data, complete, and nowhere else")
TOOLS_DIR = "scripts/keel-tools"
FIELDS = ["KEEL_TOOL_NAME", "KEEL_TOOL_EVIDENCE", "KEEL_TOOL_VERIFIED_ON", "KEEL_TOOL_TIER", "KEEL_TOOL_CLI",
          "KEEL_TOOL_PASS_MODEL", "KEEL_TOOL_STOP_HOOK", "KEEL_TOOL_HOOK_FILE", "KEEL_TOOL_LIVE_QUERY"]
FUNCTIONS = ["keel_tool_detect", "keel_tool_launch"]
chaining = (card("Chaining") or "").split()[0:1]
chaining = chaining[0].strip("`") if chaining else ""
tools_match = re.search(r"\(tools:\s*([^)]+)\)", card("Assistant config") or "")
card_tools = [t.strip(" `") for t in re.split(r"[,/]", tools_match.group(1))] if tools_match else []
if not os.path.isdir(TOOLS_DIR) and chaining in ("off", "supervised"):
    na("the card says `Chaining: %s` and %s/ does not exist — this project generates no registry" % (chaining, TOOLS_DIR))
elif not os.path.isdir(TOOLS_DIR):
    fail("%s/ does not exist although the card says `Chaining: %s`" % (TOOLS_DIR, chaining or "?"))
elif not card_tools:
    fail("%s: the card's `Assistant config:` line names no tools list `(tools: ...)`" % PROGRESS)
else:
    rows = {}
    for tool in card_tools:
        path = "%s/%s.sh" % (TOOLS_DIR, tool)
        if os.path.isfile(path):
            ok("accepted tool '%s' has its row file %s" % (tool, path))
            rows[tool] = path
        else:
            fail("accepted tool '%s' (card `Assistant config:`) has no row file %s" % (tool, path))
    for path in sorted(glob.glob(TOOLS_DIR + "/*.sh")):
        rows.setdefault(os.path.basename(path)[:-3], path)
    names = set(card_tools)
    for tool, path in sorted(rows.items()):
        text = read(path) or ""
        values, where_set = {}, {}
        for lineno, line in enumerate(text.split("\n"), 1):
            match = re.match(r"^(KEEL_TOOL_[A-Z_]+)=(.*)$", line)
            if match:
                value = code_part(match.group(2)).strip()
                if len(value) > 1 and value[0] == value[-1] and value[0] in "'\"":
                    value = value[1:-1]
                values[match.group(1)] = value
                where_set[match.group(1)] = lineno
        lacking = [f for f in FIELDS if f not in values]
        lacking += [f + "()" for f in FUNCTIONS if not re.search(r"^%s\s*\(\)" % f, text, re.M)]
        if lacking:
            fail("%s is an unfinished row — it does not declare: %s" % (path, ", ".join(lacking)))
        else:
            ok("%s declares all %d fields and both functions" % (path, len(FIELDS)))
        if values.get("KEEL_TOOL_NAME"):
            names.add(values["KEEL_TOOL_NAME"])
            if values["KEEL_TOOL_NAME"] != tool:
                fail("%s:%d KEEL_TOOL_NAME is '%s' but the file is named for '%s'"
                     % (path, where_set["KEEL_TOOL_NAME"], values["KEEL_TOOL_NAME"], tool))
        if "KEEL_TOOL_STOP_HOOK" in values and "KEEL_TOOL_HOOK_FILE" in values:
            stop, hook_file = values["KEEL_TOOL_STOP_HOOK"], values["KEEL_TOOL_HOOK_FILE"]
            registered = bool(hook_file) and "scripts/keel-stop-hook" in (read(hook_file) or "")
            if stop not in ("yes", "no"):
                fail("%s:%d KEEL_TOOL_STOP_HOOK is '%s' — it must be yes or no"
                     % (path, where_set["KEEL_TOOL_STOP_HOOK"], stop))
            elif stop == "no" and registered:
                fail("%s registers scripts/keel-stop-hook, but %s:%d says KEEL_TOOL_STOP_HOOK=\"no\". Remedy: "
                     "REMOVE the registration from %s — never change the hook's output, which would break the "
                     "integration that is already proven in the tool whose row says yes"
                     % (hook_file, path, where_set["KEEL_TOOL_STOP_HOOK"], hook_file))
            elif stop == "yes" and not registered:
                fail("%s:%d says KEEL_TOOL_STOP_HOOK=\"yes\" but %s %s. Remedy: register the hook in that file — "
                     "or, if this tool's turn-end schema is not the hook's own, set the row to \"no\"; never "
                     "change the hook's output"
                     % (path, where_set["KEEL_TOOL_STOP_HOOK"], hook_file or "(KEEL_TOOL_HOOK_FILE is empty)",
                        "does not mention scripts/keel-stop-hook" if os.path.isfile(hook_file or "")
                        else "does not exist"))
            else:
                ok("%s: KEEL_TOOL_STOP_HOOK=\"%s\" and %s %s scripts/keel-stop-hook"
                   % (path, stop, hook_file or "(no hook file)", "mentions" if registered else "does not mention"))
    shared = sorted(p for p in glob.glob("scripts/keel-*") if os.path.isfile(p))
    bad = 0
    for path in shared:
        for lineno, line in enumerate((read(path) or "").split("\n"), 1):
            code = code_part(line).lower()
            for name in sorted(names):
                if name and name.lower() in code:
                    fail("%s:%d names the tool '%s' outside a comment — a tool's facts belong in %s/%s.sh: %s"
                         % (path, lineno, name, TOOLS_DIR, name, line.strip()[:90]))
                    bad += 1
    if not bad:
        ok("no shared scripts/keel-* names a registry tool (%s) outside a comment (%d scripts)"
           % (", ".join(sorted(names)), len(shared)))

# === 27. Suppression count ===================================================
section("Suppression count")
SUPPRESS = re.compile(r"phpcs:(?:ignore|disable)|@codingStandardsIgnore|eslint-disable|@SuppressWarnings|#\s*noqa\b"
                      r"|@phpstan-ignore|stylelint-disable")
count, per_file = 0, 0
for path in TRACKED:
    if not path.endswith((".php", ".js", ".jsx", ".ts", ".tsx", ".css", ".scss")):
        continue
    if path.startswith(("docs/", "vendor/", "node_modules/")) or "/skills/keel/" in path:
        continue
    hits = len(SUPPRESS.findall(read(path) or ""))
    count += hits
    per_file += 1 if hits else 0
previous = None
for path in sprint_files:
    for match in re.finditer(r"(?i)suppression count[^0-9\n]*(\d+)", read(path) or ""):
        previous = (int(match.group(1)), path)
if previous is None:
    info("suppression count: %d in %d tracked source files; no count is recorded at a previous sprint close, so "
         "there is nothing to compare — record `Suppression count: %d` in the sprint file at this close"
         % (count, per_file, count))
elif count > previous[0]:
    info("suppression count GREW: %d now, %d recorded in %s — to be justified at the sprint close"
         % (count, previous[0], previous[1]))
else:
    info("suppression count: %d now, %d recorded in %s — did not grow" % (count, previous[0], previous[1]))
ok("suppression count reported (%d); growth is a number to justify, never an automatic failure" % count)

flush()
sys.exit(1 if STATE["failed"] else 0)
KEEL_PY
	[ $? -eq 0 ] || FAIL=1
fi

echo
echo "== Summary =="
N_FAIL=0
N_NA=0
while IFS='|' read -r num title verdict; do
	printf '%-13s %2s. %s\n' "$verdict" "$num" "$title"
	case "$verdict" in
		FAIL) N_FAIL=$((N_FAIL + 1)) ;;
		*N/A*) N_NA=$((N_NA + 1)) ;;
	esac
done < "$SUMMARY"

echo
if [ "$FAIL" -eq 0 ] && [ "$N_NA" -eq 0 ]; then
	echo "keel-verify: ALL CHECKS PASSED"
	exit 0
elif [ "$FAIL" -eq 0 ]; then
	echo "keel-verify: NO FAILURES — $N_NA check(s) not yet applicable in whole or in part (see N/A lines above; N/A is not a pass)"
	exit 0
else
	echo "keel-verify: FAILURES FOUND in $N_FAIL check(s) (see FAIL lines above)"
	exit 1
fi
