            ok("every commit on '%s' is on %s (as of the last fetch/push; no network call is made)"
               % (branch, upstream))
if branch in ("main", "master"):
    report("the current branch is the release branch '%s' — work goes to the integration branch" % branch)
elif branch == "HEAD":
    report("HEAD is detached — commits made here belong to no branch")
else:
