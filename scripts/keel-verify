#!/usr/bin/env bash
#
# keel-verify — mechanical checks that this project's docs match reality.
#
# Contract: Keel v6.5.0, references/phase-5-development.md §1a (the canonical
# list), references/project-state.md ("The sprint plan", "Session time", "The
# registry is DATA") and MANIFEST.md Table 3. Read-only: it changes nothing in
# the repository and runs no state-changing git command. Plain bash 3.2 for
# checks 1-5, python3 (stdlib only) for the rest.
#
# Every line it prints is one of:
#   OK:    the check ran and passed
#   FAIL:  the check ran and failed — file and line named; exit code 1
#   N/A:   the check could NOT run because its inputs do not exist yet; the
#          missing input is named. Never counted as a pass (§1b).
#   INFO:  a number or a list the contract says is REPORTED, never failed
#
# Checks:
#    1. Version touchpoints agree: woocommerce-redsys.php header `Version:`,
#       the REDSYS_WOOCOMMERCE_VERSION constant, readme.txt `Stable tag:`,
#       and readme.txt's top changelog entry. package.json is DELIBERATELY
#       excluded — it is a recorded, accepted drift (docs/PROGRESS.md
#       "Deferred items"), not a bug this check should re-discover every run.
#    2. Every docs/api/INDEX.md row's surface name actually exists in the
#       source tree (grep-check, not a claim).
#    3. docs/keel-conformance.md exists.
#    4. No unclosed markdown fenced code blocks (``` ... ```) anywhere in docs/.
#    5. Internal doc links (relative markdown links to other files in docs/,
#       or elsewhere in the repo) resolve to real files.
#    6. Changelog order in readme.txt (newest first, the order the version
#       touchpoint "changelog top entry" records for this project).
#    7. docs/api/INDEX.md parity: every row's Doc exists; every document in
#       docs/api/ and docs/reference/ has a row.
#    8. Extension points documented in docs/reference/ exist in the source.
#    9. No placeholder copy in distributable surfaces (readme.txt, UI strings).
#   10. i18n dry run (`wp i18n make-pot` into a temp dir): no user-facing
#       string outside the project's text domain.
#   11. Minified-asset sync — N/A until minification is adopted (D-038, S-027).
#   12. Cited commands exist (scripts, hooks, npm and composer scripts named in
#       the root *.md files and docs/).
#   13. No orphan document under docs/.
#   14. Code-map `[E]` markers in docs/03-technical-plan.md match the disk.
#   15. docs/keel-conformance.md is complete (states, decisions, paths, rows).
#   16. Every acceptance criterion is covered by ID; `Coverage` is in its enum.
#   17. `Red first` column: enum, evidence for `observed`, judgment list.
#   18. Interactive elements carry their test identifiers.
#   19. Nothing is stranded on this machine (remote, upstream, branch).
#   20. The working tree is clean.
#   21. Every recorded negative in docs/decisions.md carries `Not checked:`.
#   22. The sprint plan is well-formed (enums, ids, depends_on, plan.json
#       drift, estimate, removed slices).
#   23. The plan is not behind the work (card line, plan exists, ancestry,
#       actuals, current position).
#   24. Session time is measured, not typed (actual_source, sessions.md
#       arithmetic, projection, plan.json eligibility, .gitignore).
#   25. Test selection is wired and honest.
#   26. The tool registry is data, complete, and nowhere else.
#   27. Suppression count (reported, compared with the last sprint close).
#
# Exits 0 when no check FAILED, 1 otherwise. Every failure is printed with
# the file and line, never just "something's wrong".

set -u
cd "$(git rev-parse --show-toplevel 2>/dev/null || echo .)"

SUMMARY=$(mktemp "${TMPDIR:-/tmp}/keel-verify-summary.XXXXXX") || exit 1
trap 'rm -f "$SUMMARY"' EXIT

FAIL=0
CUR_N=""
CUR_T=""
CUR_FAIL=0
fail() { echo "FAIL: $*"; FAIL=1; CUR_FAIL=1; }
ok() { echo "OK:   $*"; }
end_check() {
	if [ -n "$CUR_N" ]; then
		if [ "$CUR_FAIL" -eq 1 ]; then
			echo "$CUR_N|$CUR_T|FAIL" >> "$SUMMARY"
		else
			echo "$CUR_N|$CUR_T|OK" >> "$SUMMARY"
		fi
	fi
	CUR_N=""
}
begin() {
	end_check
	CUR_N=$1
	CUR_T=$2
	CUR_FAIL=0
	echo "== $1. $2 =="
}

begin 1 "Version touchpoints"

MAIN_FILE="woocommerce-redsys.php"
README_FILE="readme.txt"

HEADER_VERSION=$(grep -m1 -oE '^ \* Version:[[:space:]]*[0-9][0-9A-Za-z.\-]*' "$MAIN_FILE" | sed -E 's/^ \* Version:[[:space:]]*//')
CONST_VERSION=$(grep -m1 -oE "REDSYS_WOOCOMMERCE_VERSION',[[:space:]]*'[0-9][0-9A-Za-z.\-]*" "$MAIN_FILE" | sed -E "s/.*'([0-9][0-9A-Za-z.\-]*)/\1/")
STABLE_TAG=$(grep -m1 -oE '^Stable tag:[[:space:]]*[0-9][0-9A-Za-z.\-]*' "$README_FILE" | sed -E 's/^Stable tag:[[:space:]]*//')
CHANGELOG_TOP=$(awk '/== Changelog ==/{found=1; next} found && /^== [0-9]/{gsub(/^== /,""); gsub(/ ==$/,""); print; exit}' "$README_FILE")

if [ -z "$HEADER_VERSION" ]; then fail "$MAIN_FILE: could not find 'Version:' header"; fi
if [ -z "$CONST_VERSION" ]; then fail "$MAIN_FILE: could not find REDSYS_WOOCOMMERCE_VERSION constant"; fi
if [ -z "$STABLE_TAG" ]; then fail "$README_FILE: could not find 'Stable tag:'"; fi
if [ -z "$CHANGELOG_TOP" ]; then fail "$README_FILE: could not find top changelog entry under '== Changelog =='"; fi

if [ -n "$HEADER_VERSION" ] && [ -n "$CONST_VERSION" ] && [ -n "$STABLE_TAG" ] && [ -n "$CHANGELOG_TOP" ]; then
	if [ "$HEADER_VERSION" = "$CONST_VERSION" ] && [ "$CONST_VERSION" = "$STABLE_TAG" ] && [ "$STABLE_TAG" = "$CHANGELOG_TOP" ]; then
		ok "version touchpoints agree: $HEADER_VERSION (header, constant, Stable tag, changelog top entry)"
	else
		fail "version touchpoints disagree: $MAIN_FILE Version=$HEADER_VERSION, REDSYS_WOOCOMMERCE_VERSION=$CONST_VERSION, readme.txt Stable tag=$STABLE_TAG, changelog top=$CHANGELOG_TOP"
	fi
fi
echo "(package.json version is intentionally NOT checked here — recorded gap, docs/PROGRESS.md 'Deferred items')"

echo
begin 2 "docs/api/INDEX.md rows point at real surfaces"

INDEX="docs/api/INDEX.md"
if [ ! -f "$INDEX" ]; then
	fail "$INDEX does not exist"
else
	# Parse table rows (skip header/separator), extract the first column
	# (Surface). Handles backticked names and the "`a` / `b` / `c`" pattern
	# by checking that at least one backticked token in the cell is found
	# in the source tree.
	# Gateway IDs used to build dynamic hook/filter names at runtime
	# (e.g. do_action( 'valid_' . $this->id . '_standard_ipn_request', ... )).
	# A doc row naming the RESOLVED hook (e.g. valid_redsys_standard_ipn_request)
	# will never appear as that literal string in source — only its two
	# static halves do, either side of the concatenation. So: try a literal
	# match first, and if that fails, try each known gateway id as the
	# dynamic segment and fuzzy-match the two static halves around it.
	GATEWAY_IDS="redsys bizumredsys googlepayredirecredsys inespayredsys"
	SEARCH_PATHS="classes/ includes/ woocommerce-redsys.php"

	ROW_N=0
	while IFS= read -r line; do
		ROW_N=$((ROW_N+1))
		# skip header and separator rows
		case "$line" in
			"| Surface"*|"|---"*|"|-"*) continue ;;
		esac
		[ -z "$line" ] && continue
		SURFACE_CELL=$(echo "$line" | awk -F'|' '{print $2}')
		# extract every backticked token in the cell
		TOKENS=$(echo "$SURFACE_CELL" | grep -oE '`[^`]+`' | sed -E 's/^`//; s/`$//')
		if [ -z "$TOKENS" ]; then
			continue
		fi
		FOUND_ANY=0
		while IFS= read -r tok; do
			[ -z "$tok" ] && continue
			# skip placeholder patterns like woocommerce_<gateway_id>_args —
			# they are documentation of a pattern, not a real surface name
			case "$tok" in
				*"<"*">"*) continue ;;
			esac
			# The name as the source spells it: without the call parentheses
			# of a documented function and without the `?param=` prefix of a
			# documented query-string endpoint. Searched in the gateway
			# classes, includes/ and the plugin bootstrap file, which is
			# where the INDEX's own "Code file" column places surfaces.
			needle=${tok%"()"}
			needle=${needle#\?*=}
			if grep -rqF -- "$needle" $SEARCH_PATHS 2>/dev/null; then
				FOUND_ANY=1
			else
				# fuzzy: try each known gateway id as the dynamic segment
				for gid in $GATEWAY_IDS; do
					case "$tok" in
						*"$gid"*)
							fuzzy=$(printf '%s' "$needle" | sed "s/$gid/.*/")
							if grep -rqE -- "$fuzzy" $SEARCH_PATHS 2>/dev/null; then
								FOUND_ANY=1
							fi
							;;
					esac
				done
			fi
		done <<< "$TOKENS"
		if [ "$FOUND_ANY" -eq 1 ]; then
			ok "INDEX row found in source: $(echo "$TOKENS" | tr '\n' ' ')"
		else
			fail "$INDEX:$ROW_N row's surface not found in $SEARCH_PATHS: $(echo "$TOKENS" | tr '\n' ' ')"
		fi
	done < "$INDEX"
fi

echo
begin 3 "docs/keel-conformance.md exists"
if [ -f "docs/keel-conformance.md" ]; then
	ok "docs/keel-conformance.md exists"
else
	fail "docs/keel-conformance.md is missing"
fi

echo
begin 4 "No unclosed markdown code fences in docs/"
FENCE_FAIL=0
while IFS= read -r -d '' f; do
	COUNT=$(grep -cE '^[[:space:]]*```' "$f" 2>/dev/null)
	[ -z "$COUNT" ] && COUNT=0
	if [ $(( COUNT % 2 )) -ne 0 ]; then
		fail "$f has an odd number of \`\`\` fence markers ($COUNT) — an unclosed code fence"
		FENCE_FAIL=1
	fi
done < <(find docs -type f -name '*.md' -print0)
[ "$FENCE_FAIL" -eq 0 ] && ok "all markdown files in docs/ have balanced code fences"

echo
begin 5 "Internal doc links resolve"
LINK_FAIL=0
while IFS= read -r -d '' f; do
	DIR=$(dirname "$f")
	# extract markdown links [text](target) where target does not start with
	# http://, https://, mailto:, or #
	grep -noE '\]\([^)]+\)' "$f" | while IFS=: read -r lineno match; do
		target=$(echo "$match" | sed -E 's/^\]\(//; s/\)$//')
		# strip any #anchor suffix
		target_path="${target%%#*}"
		case "$target" in
			http://*|https://*|mailto:*|"#"*|"") continue ;;
		esac
		[ -z "$target_path" ] && continue
		# resolve relative to the file's directory
		resolved="$DIR/$target_path"
		if [ ! -e "$resolved" ]; then
			echo "FAIL: $f:$lineno links to '$target_path' which does not resolve to an existing file ($resolved)"
		fi
	done
done < <(find docs -type f -name '*.md' -print0) > /tmp/keel-verify-links.$$ 2>&1

if [ -s /tmp/keel-verify-links.$$ ]; then
	cat /tmp/keel-verify-links.$$
	LINK_FAIL=1
	CUR_FAIL=1
	FAIL=1
else
	ok "all internal doc links resolve"
fi
rm -f /tmp/keel-verify-links.$$

end_check

# ---------------------------------------------------------------------------
# Checks 6-27 — python3, standard library only. The program reads the
# repository and prints; it writes nothing inside it. Temporary files (the
# i18n dry run, the selector's synthetic repository) live under $TMPDIR and
# are removed before it returns.
# ---------------------------------------------------------------------------
if ! command -v python3 >/dev/null 2>&1; then
	echo
	fail "python3 is not on PATH — checks 6-27 did not run"
else
	python3 - "$PWD" "$SUMMARY" <<'KEEL_PY'
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime

ROOT, SUMMARY = sys.argv[1], sys.argv[2]
os.chdir(ROOT)
DASH = "\u2014"
STATE = {"n": 5, "title": "", "ok": 0, "fail": 0, "na": 0, "failed": False}


def flush():
    if not STATE["title"]:
        return
    if STATE["fail"]:
        verdict = "FAIL"
    elif STATE["na"] and not STATE["ok"]:
        verdict = "N/A"
    elif STATE["na"]:
        verdict = "OK, part N/A"
    else:
        verdict = "OK"
    with open(SUMMARY, "a") as handle:
        handle.write("%d|%s|%s\n" % (STATE["n"], STATE["title"], verdict))


def section(title):
    flush()
    STATE.update(n=STATE["n"] + 1, title=title, ok=0, fail=0, na=0)
    print("")
    print("== %d. %s ==" % (STATE["n"], title))


def ok(text):
    STATE["ok"] += 1
    print("OK:   " + text)


def fail(text):
    STATE["fail"] += 1
    STATE["failed"] = True
    print("FAIL: " + text)


def na(text):
    STATE["na"] += 1
    print("N/A:  " + text)


def info(text):
    print("INFO: " + text)


def read(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            return handle.read()
    except (IOError, OSError):
        return None


def run(cmd, cwd=None, env=None):
    try:
        proc = subprocess.Popen(cmd, cwd=cwd, env=env, stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        out, err = proc.communicate()
        return proc.returncode, out.decode("utf-8", "replace"), err.decode("utf-8", "replace")
    except OSError as exc:
        return 127, "", str(exc)


def git(*args):
    return run(["git"] + list(args))


def split_row(line):
    text = line.strip()
    cells = re.split(r"(?<!\\)\|", text)
    cells = cells[1:-1] if text.endswith("|") else cells[1:]
    return [c.strip() for c in cells]


def tables(path):
    """Markdown tables outside code fences, plus the table-shaped lines that
    belong to no table (no header + separator above them)."""
    found, orphans = [], []
    lines = (read(path) or "").split("\n")
    fenced = False
    i = 0
    while i < len(lines):
        if re.match(r"^\s*```", lines[i]):
            fenced = not fenced
            i += 1
            continue
        if not fenced and lines[i].lstrip().startswith("|"):
            j = i
            while j < len(lines) and lines[j].lstrip().startswith("|"):
                j += 1
            block = [(k + 1, lines[k]) for k in range(i, j)]
            if len(block) >= 2 and re.match(r"^\s*\|[\s:|-]*-[\s:|-]*$", block[1][1]):
                found.append({"line": block[0][0], "header": split_row(block[0][1]),
                              "rows": [(n, split_row(t)) for n, t in block[2:]]})
            else:
                orphans.extend(block)
            i = j
        else:
            i += 1
    return found, orphans


def column(header, prefix):
    for index, name in enumerate(header):
        if name.strip("`* ").lower().startswith(prefix.lower()):
            return index
    return None


def number(cell):
    text = cell.replace("\u2212", "-").replace("`", "").strip()
    text = re.sub(r"\s*h$", "", text)
    try:
        return float(text)
    except ValueError:
        return None


def code_part(line):
    """The part of a shell/python line that is not a comment."""
    quote = None
    i = 0
    while i < len(line):
        ch = line[i]
        if quote:
            if ch == "\\" and quote == '"':
                i += 2
                continue
            if ch == quote:
                quote = None
        elif ch in "\"'":
            quote = ch
        elif ch == "#" and (i == 0 or line[i - 1] in " \t"):
            return line[:i]
        i += 1
    return line


IGNORED = set(p for p in git("ls-files", "--others", "--ignored", "--exclude-standard")[1].split("\n") if p)


def ignored(path):
    return path in IGNORED


# --- shared inputs -----------------------------------------------------------
PROGRESS = "docs/PROGRESS.md"
DECISIONS = "docs/decisions.md"
PLAN = "docs/03-technical-plan.md"
TESTPOINTS = "docs/05-test-points.md"
progress_text = read(PROGRESS) or ""
decisions_text = read(DECISIONS) or ""
DECISION_IDS = set(re.findall(r"^## (D-\d+)\b", decisions_text, re.M))
card_match = re.search(r"^## Project card\s*\n(.*?)(?=^## )", progress_text, re.M | re.S)
CARD = card_match.group(1) if card_match else ""


def card(key):
    match = re.search(r"^- %s:[ \t]*(.*)$" % re.escape(key), CARD, re.M)
    return match.group(1).strip() if match else None


def real_decisions(text):
    return [d for d in re.findall(r"\bD-\d+\b", text or "") if d in DECISION_IDS]


TRACKED = [p for p in git("ls-files")[1].split("\n") if p]


def source_files():
    out = []
    for path in TRACKED:
        if not path.endswith(".php"):
            continue
        if path.startswith(("tests/", "vendor/", "node_modules/", "docs/", ".")):
            continue
        out.append(path)
    return out


# === 6. Changelog order ======================================================
section("Changelog order (readme.txt, newest first)")
readme = read("readme.txt")
if readme is None:
    na("readme.txt does not exist — no changelog to order")
else:
    entries, inside = [], False
    for lineno, line in enumerate(readme.split("\n"), 1):
        if re.match(r"^==\s*Changelog\s*==\s*$", line, re.I):
            inside = True
            continue
        if not inside:
            continue
        head = re.match(r"^=+\s*(.+?)\s*=+\s*$", line)
        if not head:
            continue
        name = head.group(1)
        if re.match(r"^\d+(\.\d+)*$", name):
            entries.append((lineno, name, tuple(int(x) for x in name.split("."))))
        elif name.lower() == "unreleased":
            entries.append((lineno, name, None))
        elif line.startswith("== "):
            break
    versions = [e for e in entries if e[2] is not None]
    bad = 0
    for index, entry in enumerate(entries):
        if entry[2] is None and index != 0:
            fail("readme.txt:%d '%s' is not the first changelog entry" % (entry[0], entry[1]))
            bad += 1
    for prev, cur in zip(versions, versions[1:]):
        if not cur[2] < prev[2]:
            fail("readme.txt:%d changelog entry %s follows %s (line %d) — entries must run "
                 "newest to oldest" % (cur[0], cur[1], prev[1], prev[0]))
            bad += 1
    if not versions:
        fail("readme.txt: no version entry found under '== Changelog =='")
    elif not bad:
        ok("readme.txt changelog: %d entries, strictly newest to oldest (%s ... %s)"
           % (len(versions), versions[0][1], versions[-1][1]))

# === 7. INDEX parity =========================================================
section("docs/api/INDEX.md parity")
INDEX = "docs/api/INDEX.md"
if read(INDEX) is None:
    na("%s does not exist" % INDEX)
else:
    found, _ = tables(INDEX)
    table = next((t for t in found if column(t["header"], "Doc") is not None), None)
    if table is None:
        fail("%s: no table with a 'Doc' column" % INDEX)
    else:
        doc_col = column(table["header"], "Doc")
        listed, bad = set(), 0
        for lineno, cells in table["rows"]:
            if len(cells) != len(table["header"]):
                fail("%s:%d row has %d cells, the header has %d" % (INDEX, lineno, len(cells), len(table["header"])))
                bad += 1
                continue
            paths = re.findall(r"[\w./\-]+\.md", cells[doc_col])
            if not paths:
                fail("%s:%d row names no document in its Doc column" % (INDEX, lineno))
                bad += 1
            for path in paths:
                listed.add(os.path.normpath(path))
                if not os.path.isfile(path):
                    fail("%s:%d Doc '%s' does not exist" % (INDEX, lineno, path))
                    bad += 1
        docs = sorted(glob.glob("docs/api/**/*.md", recursive=True) + glob.glob("docs/reference/**/*.md", recursive=True))
        for doc in docs:
            if os.path.basename(doc) in ("INDEX.md", "README.md"):
                continue
            if os.path.normpath(doc) not in listed:
                fail("%s has no row in %s" % (doc, INDEX))
                bad += 1
        if not bad:
            ok("%d rows name existing documents; every document in docs/api/ and docs/reference/ has a row "
               "(INDEX.md and README.md are navigation, not surface documents)" % len(table["rows"]))

# === 8. Documented extension points exist ====================================
section("Extension points documented in docs/reference/ exist in the source")
GATEWAY_IDS = ["redsys", "bizumredsys", "googlepayredirecredsys", "inespayredsys"]
HOOKS_DOC = "docs/reference/hooks-and-extension-points.md"
hooks_text = read(HOOKS_DOC)
if hooks_text is None:
    na("%s does not exist — no documented extension point to look for" % HOOKS_DOC)
else:
    source = "\n".join(read(p) or "" for p in source_files())
    checked = bad = 0
    for lineno, line in enumerate(hooks_text.split("\n"), 1):
        if not re.match(r"^###\s", line):
            continue
        tokens = re.findall(r"`([^`]+)`", line)
        first = None
        for token in tokens:
            name = token
            if name.startswith("_") and first:
                name = first.rsplit("_", 1)[0] + name
            elif first is None:
                first = name
            candidates = [name]
            if "<" in name and ">" in name:
                stem = re.sub(r"<[^>]+>", "\0", name)
                candidates = [stem.replace("\0", gid) for gid in GATEWAY_IDS]

            def in_source(cand):
                # literal, or (as in check 2) the two static halves of a name
                # the source builds around a gateway id on one line
                if cand in source:
                    return True
                for gid in GATEWAY_IDS:
                    if gid in cand:
                        left, right = cand.split(gid, 1)
                        if re.search(re.escape(left) + ".*" + re.escape(right), source):
                            return True
                return False

            # a `<gateway id>` pattern heading holds when EVERY gateway id resolves
            hit = all(in_source(c) for c in candidates)
            checked += 1
            if not hit:
                fail("%s:%d documents `%s`, which is not found in the source tree" % (HOOKS_DOC, lineno, name))
                bad += 1
    if not checked:
        fail("%s: no `name` found in any '###' heading — nothing was checked" % HOOKS_DOC)
    elif not bad:
        ok("%d documented hook names found in the source (literal, or built around a gateway id)" % checked)

# === 9. Placeholder copy =====================================================
section("No placeholder copy in distributable surfaces")
MARKER = re.compile(r"\bTODO\b|\bFIXME\b|\bTBD\b|\bXXX\b|PLACEHOLDER|[Ll]orem ipsum")
bad = scanned = 0
if readme is not None:
    scanned += 1
    for lineno, line in enumerate(readme.split("\n"), 1):
        if MARKER.search(line):
            fail("readme.txt:%d placeholder marker: %s" % (lineno, line.strip()[:100]))
            bad += 1
GETTEXT = re.compile(r"\b(?:__|_e|_x|_ex|_n|_nx|esc_html__|esc_html_e|esc_html_x|esc_attr__|esc_attr_e|esc_attr_x)"
                     r"\(\s*(['\"])((?:\\.|(?!\1).)*)\1")
ui_files = source_files() + [p for p in TRACKED if p.startswith("resources/") and p.endswith((".js", ".jsx"))]
strings = 0
for path in ui_files:
    for lineno, line in enumerate((read(path) or "").split("\n"), 1):
        for match in GETTEXT.finditer(line):
            strings += 1
            if MARKER.search(match.group(2)):
                fail("%s:%d placeholder marker in a UI string: %s" % (path, lineno, match.group(2)[:100]))
                bad += 1
if not scanned and not strings:
    na("no readme.txt and no translatable string found — nothing distributable to scan")
elif not bad:
    ok("no TODO/FIXME/TBD/XXX/PLACEHOLDER/lorem marker in readme.txt or in %d UI strings (%d files)"
       % (strings, len(ui_files)))

# === 10. i18n dry run ========================================================
section("i18n dry run (wp i18n make-pot): text domain")
domain_match = re.search(r"text domain `([^`]+)`", card("i18n") or "")
if not domain_match:
    na("the project card's `i18n:` line names no text domain — nothing to check against")
elif not shutil.which("wp"):
    na("`wp` (WP-CLI) is not on PATH — the make-pot dry run cannot run on this machine")
else:
    domain = domain_match.group(1)
    tmp = tempfile.mkdtemp(prefix="keel-verify-pot.")
    try:
        exclude = ["node_modules", "vendor", "languages", "assets", "tests", "docs", "scripts"]
        exclude += [e for e in os.listdir(".") if e.startswith(".") and os.path.isdir(e)]
        base = ["wp", "i18n", "make-pot", ".", None, "--exclude=" + ",".join(exclude)]

        def pot(name, extra):
            target = os.path.join(tmp, name)
            cmd = list(base)
            cmd[4] = target
            rc, out, err = run(cmd + extra)
            if rc != 0 or not os.path.isfile(target):
                return None, (err or out).strip().split("\n")[-1]
            entries = {}
            for chunk in (read(target) or "").split("\n\n"):
                msgid = re.search(r'^msgid ((?:".*"\n?)+)', chunk, re.M)
                if not msgid:
                    continue
                text = "".join(re.findall(r'"(.*)"', msgid.group(1)))
                context = re.search(r'^msgctxt "(.*)"', chunk, re.M)
                ref = re.search(r"^#: (\S+)", chunk, re.M)
                if text:
                    entries[(context.group(1) if context else "", text)] = ref.group(1) if ref else "?"
            return entries, ""

        own, err_own = pot("domain.pot", ["--domain=" + domain])
        everything, err_all = pot("all.pot", ["--ignore-domain"])
        if own is None or everything is None:
            fail("`wp i18n make-pot` failed: %s" % (err_own or err_all))
        else:
            stray = sorted((ref, key[1]) for key, ref in everything.items() if key not in own)
            for ref, text in stray:
                fail("%s string outside the text domain '%s': %s" % (ref, domain, text[:80]))
            if not stray:
                ok("make-pot dry run: %d strings, all in the text domain '%s'" % (len(own), domain))
            info("make-pot cannot see a user-facing string that is not wrapped in a translation call at all; "
                 "that half of the rule stays with the PHPCS i18n sniffs (not installed — technical plan)")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

# === 11. Minified-asset sync =================================================
section("Minified-asset sync")
minified = [p for p in TRACKED if re.search(r"\.min\.(css|js)$", p)]
if minified:
    fail("%d minified file(s) are tracked (%s ...) but this check has no minify command to compare them "
         "against — extend check 11 with the build command the minification slice introduced"
         % (len(minified), minified[0]))
elif "D-038" in DECISION_IDS:
    na("minification is not adopted yet: D-038 schedules it as slice S-027, and no `name.min.css` / "
       "`name.min.js` exists in the tree — nothing to compare")
else:
    fail("the plugin ships front-end CSS/JS with no minified pair and docs/decisions.md records no decision "
         "about it (D-038 not found)")

# === 12. Cited commands exist ================================================
section("Cited commands exist")
doc_files = sorted(glob.glob("*.md")) + sorted(glob.glob("docs/**/*.md", recursive=True))
doc_files = [p for p in doc_files if not ignored(p)]
try:
    npm_scripts = set((json.loads(read("package.json") or "{}").get("scripts") or {}).keys())
except ValueError:
    npm_scripts = set()
try:
    composer_scripts = set((json.loads(read("composer.json") or "{}").get("scripts") or {}).keys())
except ValueError:
    composer_scripts = set()
COMPOSER_BUILTIN = set("install update require remove dump-autoload dumpautoload validate exec global show outdated "
                       "audit create-project self-update config init check-platform-reqs diagnose licenses status "
                       "why depends prohibits archive clear-cache search browse home fund bump reinstall run "
                       "run-script".split())
PATH_CITE = re.compile(r"(?<![\w/.\-])(?:\./)?((?:scripts|bin|\.githooks)/[A-Za-z0-9_.\-/]*[A-Za-z0-9_/])")
cited = bad = 0
for path in doc_files:
    fenced = False
    for lineno, line in enumerate((read(path) or "").split("\n"), 1):
        if re.match(r"^\s*```", line):
            fenced = not fenced
            continue
        if path == "docs/keel-conformance.md" and re.search(r"\|\s*(missing|declined|n/a)\s*\|", line):
            # a row in one of these states names an artifact to say it is absent
            continue
        for match in PATH_CITE.finditer(line):
            rest = line[match.end():match.end() + 1]
            target = match.group(1)
            if rest and rest in "<*{[$\u2026-":
                continue
            if rest == "." and line[match.end() + 1:match.end() + 2].isalnum():
                continue
            cited += 1
            if not os.path.exists(target):
                fail("%s:%d cites '%s', which does not exist" % (path, lineno, target))
                bad += 1
        spans = [line] if fenced else re.findall(r"`([^`]+)`", line)
        for span in spans:
            for match in re.finditer(r"\bnpm run(?:-script)? ([\w:.\-]+)", span):
                cited += 1
                if match.group(1) not in npm_scripts:
                    fail("%s:%d cites 'npm run %s', which is not a script in package.json"
                         % (path, lineno, match.group(1)))
                    bad += 1
            for match in re.finditer(r"(?:^|[\s;&(])composer (?:run-script |run )?([a-z][\w:\-]*)", span):
                name = match.group(1)
                if name in COMPOSER_BUILTIN:
                    continue
                cited += 1
                if name not in composer_scripts:
                    fail("%s:%d cites 'composer %s', which is neither a Composer command nor a script in "
                         "composer.json" % (path, lineno, name))
                    bad += 1
if not bad:
    ok("%d citations of scripts/, bin/, .githooks/, npm and composer scripts in %d documents all resolve"
       % (cited, len(doc_files)))

# === 13. No orphan documents =================================================
section("No orphan document under docs/")
docs_all = sorted(p for p in glob.glob("docs/**/*.md", recursive=True) if not ignored(p))
LINK = re.compile(r"\]\(([^)\s]+)\)")
MENTION = re.compile(r"(?<![\w/.\-])((?:docs|guide)/[\w.\-/]+\.md)")


def references(path):
    out = set()
    text = read(path) or ""
    for target in LINK.findall(text):
        target = target.split("#")[0]
        if not target or re.match(r"^[a-z]+:", target):
            continue
        out.add(os.path.normpath(os.path.join(os.path.dirname(path), target)))
    for target in MENTION.findall(text):
        out.add(os.path.normpath(target))
    return out


roots = [p for p in (PROGRESS, INDEX) if os.path.isfile(p)]
if not roots:
    na("neither %s nor %s exists — no root to reach documents from" % (PROGRESS, INDEX))
else:
    reached, queue = set(roots), list(roots)
    while queue:
        for target in references(queue.pop()):
            if target in docs_all and target not in reached:
                reached.add(target)
                queue.append(target)
    orphans = [p for p in docs_all if p not in reached]
    for path in orphans:
        fail("%s is reachable from neither %s nor %s (no link and no path mention leads to it)"
             % (path, PROGRESS, INDEX))
    if not orphans:
        ok("all %d documents under docs/ are reachable from %s" % (len(docs_all), " or ".join(roots)))

# === 14. Code-map markers ====================================================
section("Code-map [E] markers match the disk")
plan_text = read(PLAN)
if plan_text is None:
    na("%s does not exist" % PLAN)
else:
    lines = plan_text.split("\n")
    start = next((i for i, l in enumerate(lines) if re.match(r"^#+ .*Code map", l)), None)
    block, opened = [], False
    if start is not None:
        for i in range(start + 1, len(lines)):
            if re.match(r"^\s*```", lines[i]):
                if opened:
                    break
                opened = True
                continue
            if opened:
                block.append((i + 1, lines[i]))
            elif lines[i].startswith("#"):
                break
    if not block:
        fail("%s: no fenced code map found under a 'Code map' heading" % PLAN)
    else:
        stack, checked, bad = [], 0, 0
        for lineno, line in block:
            if not line.strip():
                continue
            indent = len(line) - len(line.lstrip(" "))
            marker = re.search(r"\[([EAG])\]", line)
            spec = (line[:marker.start()] if marker else line).strip()
            while stack and stack[-1][0] >= indent:
                stack.pop()
            parent = stack[-1][1] if stack else ""
            items = [x.strip() for x in re.split(r",\s+|\s+\+\s+", spec) if x.strip()]
            if not items:
                continue
            first = parent + items[0]
            paths = [first]
            sibling_dir = os.path.dirname(first.rstrip("/"))
            for item in items[1:]:
                paths.append((sibling_dir + "/" if sibling_dir else "") + item)
            if len(items) == 1 and items[0].endswith("/"):
                stack.append((indent, first))
            if marker and marker.group(1) == "E":
                for path in paths:
                    checked += 1
                    if not os.path.exists(path.rstrip("/")):
                        fail("%s:%d marks '%s' as [E] but it does not exist on disk" % (PLAN, lineno, path))
                        bad += 1
        if not checked:
            fail("%s: the code map carries no [E] marker — nothing was checked" % PLAN)
        elif not bad:
            ok("%d paths marked [E] in the code map exist on disk" % checked)

# === 15. Keel conformance ====================================================
section("Keel conformance is complete")
CONF = "docs/keel-conformance.md"
if read(CONF) is None:
    fail("%s is missing" % CONF)
else:
    found, _ = tables(CONF)
    state_tables = [t for t in found if "State" in t["header"]]
    counts = {"present": 0, "missing": 0, "declined": 0, "n/a": 0}
    bad, seen, t1_rows = 0, {}, 0
    for table in state_tables:
        col = table["header"].index("State")
        for lineno, cells in table["rows"]:
            if len(cells) != len(table["header"]):
                fail("%s:%d row has %d cells, its header has %d" % (CONF, lineno, len(cells), len(table["header"])))
                bad += 1
                continue
            rid, state, text = cells[0], cells[col], " ".join(cells)
            if rid in seen:
                fail("%s:%d row id %s is also on line %d" % (CONF, lineno, rid, seen[rid]))
                bad += 1
            seen[rid] = lineno
            if re.match(r"^T1-\d+$", rid):
                t1_rows += 1
            if state not in counts:
                fail("%s:%d %s has state '%s' — not one of present / missing / declined / n/a"
                     % (CONF, lineno, rid, state))
                bad += 1
                continue
            counts[state] += 1
            if state == "missing" and not real_decisions(text):
                fail("%s:%d %s is `missing` and cites no decision recorded in %s" % (CONF, lineno, rid, DECISIONS))
                bad += 1
            elif state == "declined" and not real_decisions(text):
                fail("%s:%d %s is `declined` and cites no decision recorded in %s" % (CONF, lineno, rid, DECISIONS))
                bad += 1
            elif state == "n/a" and not cells[-1].strip(DASH + "- "):
                fail("%s:%d %s is `n/a` with no excluding condition" % (CONF, lineno, rid))
                bad += 1
            elif state == "present" and rid.startswith("T1-"):
                for token in re.findall(r"`([^`]+)`", cells[1]):
                    if token.endswith(":"):
                        if rid.startswith("T1-C") and not re.search(r"\b%s" % re.escape(token), CARD):
                            fail("%s:%d %s is `present` but the project card has no `%s` line"
                                 % (CONF, lineno, rid, token))
                            bad += 1
                    elif re.match(r"^[\w.\-/]+$", token) and (
                            "/" in token or re.search(r"\.(md|json|jsonl|sh|txt|xml|yml|yaml|php|js|css)$", token)):
                        if not os.path.exists(token.rstrip("/")):
                            fail("%s:%d %s is `present` but '%s' does not exist" % (CONF, lineno, rid, token))
                            bad += 1
    if not state_tables:
        fail("%s: no table with a 'State' column" % CONF)
    else:
        manifests = sorted(glob.glob(".*/skills/keel/MANIFEST.md"))
        if manifests:
            body = re.search(r"^## Table 1.*?(?=^## Table 2)", read(manifests[0]) or "", re.M | re.S)
            want = len([l for l in (body.group(0) if body else "").split("\n") if l.startswith("|")]) - 2
            if want != t1_rows:
                fail("%s carries %d Table 1 path rows (T1-nn); %s Table 1 has %d requirements"
                     % (CONF, t1_rows, manifests[0], want))
                bad += 1
        else:
            na("no embedded Keel MANIFEST.md found — the Table 1 row count cannot be compared")
        info("%d rows: %d present, %d missing, %d declined, %d n/a" % (
            sum(counts.values()), counts["present"], counts["missing"], counts["declined"], counts["n/a"]))
        if not bad:
            ok("every row has one of the four states; every `missing` and `declined` row cites a recorded "
               "decision; every `present` Table 1 path and card line exists")

# === 16. Acceptance criteria covered =========================================
section("Acceptance criteria covered by ID; Coverage in its enum")
SPEC = "docs/02-functional-spec.md"
TAGS = ["CREDENTIAL", "HARDWARE", "ASSISTIVE-TECH", "JUDGMENT", "EXTERNAL-APPROVAL", "PLATFORM-IMPOSSIBLE",
        "PRODUCTION-RISK", "NO-EXECUTION"]
tp_table = None
if read(TESTPOINTS) is None:
    na("%s does not exist" % TESTPOINTS)
else:
    found, orphan_rows = tables(TESTPOINTS)
    tp_table = next((t for t in found if column(t["header"], "Coverage") is not None
                     and column(t["header"], "Criterion") is not None), None)
    if tp_table is None:
        fail("%s: no table with `Criterion` and `Coverage` columns" % TESTPOINTS)
    else:
        bad = 0
        for lineno, _ in orphan_rows:
            fail("%s:%d table row outside any table (a blank line or a missing header splits the table)"
                 % (TESTPOINTS, lineno))
            bad += 1
        crit, cov = column(tp_table["header"], "Criterion"), column(tp_table["header"], "Coverage")
        steps = column(tp_table["header"], "Delegation steps")
        covered = set()
        good_rows = []
        for lineno, cells in tp_table["rows"]:
            if len(cells) != len(tp_table["header"]):
                fail("%s:%d row has %d cells, the header has %d" % (TESTPOINTS, lineno, len(cells),
                                                                    len(tp_table["header"])))
                bad += 1
                continue
            good_rows.append((lineno, cells))
            covered.update(re.findall(r"\bAC-\d+\b", cells[crit]))
            value = cells[cov].strip("` ")
            if value != "driven" and value not in TAGS:
                fail("%s:%d Coverage is '%s' — not `driven` and not one of the eight delegation tags"
                     % (TESTPOINTS, lineno, value))
                bad += 1
            elif value in TAGS:
                text = cells[steps].strip(DASH + "-` ") if steps is not None else ""
                if not text or text.lower() == "n/a":
                    fail("%s:%d Coverage is the delegation tag %s but the row carries no delegation steps"
                         % (TESTPOINTS, lineno, value))
                    bad += 1
        tp_table["good"] = good_rows
        spec_text = read(SPEC)
        section_ac = re.search(r"^## [^\n]*Acceptance criteria.*?(?=^## |\Z)", spec_text or "", re.M | re.S)
        ids = []
        if section_ac:
            for line in section_ac.group(0).split("\n"):
                match = re.match(r"^\|\s*(AC-\d+)\s*\|", line)
                if match and "withdrawn" not in line.lower():
                    ids.append(match.group(1))
        if spec_text is None or not ids:
            na("%s defines no `AC-nn` criterion — nothing to match rows against" % SPEC)
        else:
            lacking = [i for i in ids if i not in covered]
            if lacking:
                fail("%s: %d of %d acceptance criteria from %s have no row naming them in the Criterion column: %s"
                     % (TESTPOINTS, len(lacking), len(ids), SPEC, ", ".join(lacking)))
                bad += 1
            unknown = sorted(covered - set(ids))
            for name in unknown:
                fail("%s names %s, which %s does not define" % (TESTPOINTS, name, SPEC))
                bad += 1
        if not bad:
            ok("%d rows: every Coverage cell is in the enum, tagged rows carry steps, every AC-nn has a row"
               % len(good_rows))

# === 17. Red first ===========================================================
section("Red first column")
RED = ["observed", "n/a %s policy" % DASH, "n/a %s out of scope" % DASH, "n/a %s predates" % DASH,
       "n/a %s delegated" % DASH]
policy = card("Test-first policy")
if tp_table is None:
    na("%s has no test-point table to read" % TESTPOINTS)
elif column(tp_table["header"], "Red first") is None:
    fail("%s:%d the test-point table has no `Red first` column" % (TESTPOINTS, tp_table["line"]))
else:
    red = column(tp_table["header"], "Red first")
    evidence = column(tp_table["header"], "Evidence")
    FAILURE = re.compile(r"\b(red|fail\w*|error\w*|assert\w*|expected|exception|timed? ?out|not ok)\b", re.I)
    bad, judge = 0, {}
    for lineno, cells in tp_table.get("good", []):
        value = cells[red].strip("` ")
        if value not in RED:
            fail("%s:%d Red first is '%s' — not one of the five values" % (TESTPOINTS, lineno, value))
            bad += 1
            continue
        if value == "observed":
            cell = cells[evidence] if evidence is not None else ""
            if not FAILURE.search(cell):
                fail("%s:%d Red first is `observed` but the Evidence cell carries no failure output"
                     % (TESTPOINTS, lineno))
                bad += 1
        elif value != RED[4]:
            judge.setdefault(value, []).append(lineno)
    if not bad:
        ok("%d rows: every Red first cell holds one of the five values; every `observed` row has its failure output"
           % len(tp_table.get("good", [])))
    if policy and policy.split()[0].strip("`") == "none":
        info("Test-first policy is `none` (%s) — no row list" % (", ".join(real_decisions(policy)) or "no decision cited"))
    else:
        for value in sorted(judge):
            info("for a person to judge — `%s`: %d row(s), %s lines %s" % (
                value, len(judge[value]), TESTPOINTS, ", ".join(str(n) for n in judge[value])))
        if not judge:
            info("no `policy` / `out of scope` / `predates` row to judge")

