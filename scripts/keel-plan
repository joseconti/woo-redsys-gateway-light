#!/usr/bin/env bash
#
# keel-plan — generator for the DERIVED layer of the sprint plan, per Keel's
# references/project-state.md ("The sprint plan — one plan, three layers, one
# job each").
#
# Layers:
#   1. Authority  docs/sprints/sprint-<N>.md  (frontmatter `keel.sprint/1`, or
#                 `keel.sprint/2` for a parallel-capable active sprint)
#   2. Backlog    docs/sprints/deferred.md    (frontmatter `keel.deferred/1`)
#   3. Derived    docs/.keel/plan.json        (`keel.plan/2`; this script writes
#                                              it; nobody edits it by hand)
#      plus the human index table in docs/sprints/README.md, regenerated in
#      the same pass between the two marker comments
#      `<!-- keel-plan:index:begin -->` / `<!-- keel-plan:index:end -->`.
#
# Slice schema (Keel v6.6.0, "Scope ownership and residual estimates"):
#   original_hours     approved estimate at creation; immutable
#   residual_hours     current estimate of the unbuilt scope; 0 when done/dropped
#   change_kind        added | extracted | re-estimated
#   parent_slice       required for extracted, otherwise null
#   owns               requirement ids owned exclusively by this slice
#   estimate_changes   append-only block list; each record carries
#                      before_residual_hours, after_residual_hours, reason,
#                      date, decision (or reference) and reconciliation (the id
#                      of the sprint's scope_reconciliations record written in
#                      the same checkpoint)
# A sprint file may carry a top-level `scope_reconciliations:` block list; each
# record has id, date, reason, slices, remaining_before, completed_residual,
# added_scope, explicit_residual_reestimates, remaining_after, and must satisfy
#   remaining_before - completed_residual + added_scope
#     + explicit_residual_reestimates = remaining_after.
# A legacy `hours:` field is refused: it is migrated to original_hours.
#
# Sprint schema v2 (Keel v7.0.0, references/parallel-development.md, "Sprint
# plan version 2"): a `keel.sprint/2` file keeps every field above and may add
# to each slice the closed mapping
#   execution:
#     write_paths: [repo-relative files or dir prefixes ending in /; no globs]
#     contracts:
#       reads: [contract names]
#       writes: [contract names]
#     exclusive_resources: [shared mutable environments]
#     parallel: eligible | serial
#     serial_reason: <text; required when serial, null otherwise>
# An `execution:` mapping in a `keel.sprint/1` file is refused. Missing
# execution metadata means UNKNOWN, never eligible: `validate` prints an
# `UNMAPPED:` line (not a failure) for each open v2 slice without it. The
# mapping is carried verbatim (normalised) into plan.json, and `validate`
# also runs scripts/keel-parallel validate over the generated plan when that
# helper exists, so the DAG/ownership rules have one implementation.
#
# Commands:
#   build     Parse every sprint file and deferred.md, write docs/.keel/plan.json
#             and the README index table. Files are rewritten only when their
#             content changes. Exit 0.
#   check     Exit 1, naming every difference, if plan.json or the README index
#             table is not what `build` would produce right now. Writes nothing.
#             Exit 0 when both match.
#   validate  Exit 1, naming every problem, when the scope-ownership contract
#             is broken: a done/dropped slice with a residual, an extraction
#             without parent/ownership/reconciliation, two counted slices that
#             own the same requirement, a residual change without its
#             estimate_changes record, or a balance equation that does not
#             hold. Prints `UNRECONCILED:` lines (not a failure) for open slices
#             with no ownership. Writes nothing. (scripts/keel-verify runs it.)
#   left      Print the fixed "what is left" block, computed from the SOURCES
#             (never from a possibly stale plan.json). Writes nothing.
#   json      Print to stdout exactly what `build` would write to plan.json.
#             Writes nothing. (scripts/keel-time uses this, so the plan
#             arithmetic has ONE implementation.)
#
# Exit codes: 0 ok · 1 drift (`check`) or invalid scope (`validate`) · 2 usage
# error, unreadable or invalid source (bad frontmatter, status outside the
# closed enum, non-numeric hours, duplicate id), or no repository root.
#
# What is computed (never stored in the sources), per sprint and plan-wide:
#   original_estimated_hours   original_hours of every slice not `dropped`
#   completed_original_hours   original_hours of `done` slices
#   actual_hours               actual_hours of `done` slices
#   remaining_hours            residual_hours of slices neither done nor dropped
#   deviation_hours            actual_hours - completed_original_hours
#   pace_factor                PLAN-WIDE: sum(actual)/sum(original_hours) over
#                              slices that are done + actual_source: measured +
#                              original_hours > 0 + numeric actual_hours >= 0;
#                              null when there is no such slice
#   projected_remaining_hours  remaining_hours x pace_factor; 0 when nothing
#                              remains; null when work remains and no factor
#   reconciliation_status      reconciled | unreconciled (an open slice owns
#                              no requirement)
#   scope_delta                added scope, extracted scope and explicit
#                              residual re-estimates, separately
#   percent_done               completed_original / original_estimated x 100
#   unit                       the label every rendered duration must carry
# deferred.md and any contingency are excluded from all of them.
#
# Determinism: plan.json carries NO timestamp and nothing machine-specific,
# so two runs over unchanged sources are byte-identical. Arithmetic is done
# on unrounded values; stored figures are rounded only at output (hours to
# 4 decimals, pace_factor to 6, percentages to 2).
#
# Repository root: `git rev-parse --show-toplevel`, or the directory named by
# the environment variable KEEL_ROOT when it is set (used by tests to run
# against a scratch copy).
#
# Requires: bash 3.2+, python3 (standard library only).

set -u

usage() {
  echo "usage: scripts/keel-plan build | check | validate | left | json" >&2
  exit 2
}

[ $# -eq 1 ] || usage
case "$1" in
  build|check|validate|left|json) ;;
  *) usage ;;
esac

if [ -n "${KEEL_ROOT:-}" ]; then
  ROOT="$KEEL_ROOT"
else
  ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
fi
if [ -z "$ROOT" ] || [ ! -d "$ROOT" ]; then
  echo "keel-plan: no repository root (not inside a git repository and KEEL_ROOT is not set)" >&2
  exit 2
fi

command -v python3 >/dev/null 2>&1 || { echo "keel-plan: python3 not found" >&2; exit 2; }

exec python3 - "$ROOT" "$1" <<'PY'
# -*- coding: utf-8 -*-
import glob
import io
import json
import os
import re
import sys

ROOT = sys.argv[1]
CMD = sys.argv[2]

SPRINTS_DIR = os.path.join(ROOT, "docs", "sprints")
DEFERRED = os.path.join(SPRINTS_DIR, "deferred.md")
README = os.path.join(SPRINTS_DIR, "README.md")
PLAN = os.path.join(ROOT, "docs", ".keel", "plan.json")

UNIT = "hours of AI working time plus supervision"
STATUSES = ("not-started", "in-progress", "done", "dropped")
SPRINT_SCHEMAS = ("keel.sprint/1", "keel.sprint/2")
SOURCES = ("measured", "estimated")
BEGIN = "<!-- keel-plan:index:begin -->"
END = "<!-- keel-plan:index:end -->"
PROVISIONAL_BELOW = 4  # fewer eligible slices than this = "provisional sample"
MINUS = u"−"
DASH = u"—"


class PlanError(Exception):
    pass


def out(text):
    # Bytes, so the output is UTF-8 whatever the caller's locale is.
    sys.stdout.buffer.write(text.encode("utf-8"))
    sys.stdout.flush()


def read(path):
    with io.open(path, "r", encoding="utf-8", newline="") as fh:
        return fh.read()


def rel(path):
    return os.path.relpath(path, ROOT).replace(os.sep, "/")


# --- frontmatter: the closed subset of YAML the sprint schema uses -----------

def strip_comment(text):
    """Drop a trailing ` # comment` that is outside quotes."""
    quote = None
    for i, ch in enumerate(text):
        if quote:
            if ch == quote:
                quote = None
        elif ch in "\"'":
            quote = ch
        elif ch == "#" and (i == 0 or text[i - 1] in " \t"):
            return text[:i].rstrip()
    return text.rstrip()


def scalar(text):
    text = text.strip()
    if text == "" or text in ("null", "~", "Null", "NULL"):
        return None
    if len(text) >= 2 and text[0] == text[-1] and text[0] in "\"'":
        return text[1:-1]
    if text in ("true", "True"):
        return True
    if text in ("false", "False"):
        return False
    if re.match(r"^[+-]?\d+$", text):
        return int(text)
    if re.match(r"^[+-]?(\d+\.\d*|\.\d+)$", text):
        return float(text)
    return text


def value(text):
    text = strip_comment(text).strip()
    if text.startswith("[") and text.endswith("]"):
        inner = text[1:-1].strip()
        if not inner:
            return []
        return [scalar(part) for part in inner.split(",")]
    return scalar(text)


KEY = re.compile(r"^([A-Za-z_][\w-]*):(.*)$")


def is_item(body):
    return body == "-" or body.startswith("- ")


def parse_mapping(path, rows, i, indent):
    """A block mapping at exactly `indent`; nested blocks must be indented deeper."""
    result = {}
    while i < len(rows) and rows[i][1] == indent and not is_item(rows[i][2]):
        number, _, body = rows[i]
        match = KEY.match(body)
        if not match:
            raise PlanError("%s:%d: cannot parse '%s'" % (rel(path), number, body))
        key, rest = match.group(1), strip_comment(match.group(2)).strip()
        if key in result:
            raise PlanError("%s:%d: key '%s' appears twice" % (rel(path), number, key))
        i += 1
        if rest == "" and i < len(rows) and rows[i][1] > indent:
            result[key], i = parse_block(path, rows, i, rows[i][1])
        else:
            result[key] = value(rest)
    if i < len(rows) and rows[i][1] > indent:
        raise PlanError("%s:%d: unexpected indentation '%s'" % (rel(path), rows[i][0], rows[i][2]))
    return result, i


def parse_list(path, rows, i, indent):
    items = []
    while i < len(rows) and rows[i][1] == indent and is_item(rows[i][2]):
        number, _, body = rows[i]
        rest = body[1:].strip()
        if KEY.match(rest):
            rows[i] = (number, indent + 2, rest)
            mapping, i = parse_mapping(path, rows, i, indent + 2)
            mapping["_line"] = number
            items.append(mapping)
        else:
            items.append(value(rest))
            i += 1
    return items, i


def parse_block(path, rows, i, indent):
    if is_item(rows[i][2]):
        return parse_list(path, rows, i, indent)
    return parse_mapping(path, rows, i, indent)


def frontmatter(path):
    """Return (top-level dict, list of item dicts) from a file's frontmatter.

    The closed YAML subset: block mappings, block lists of mappings or
    scalars, inline lists of scalars; nested blocks indented deeper than
    their key."""
    lines = read(path).replace("\r\n", "\n").split("\n")
    if not lines or lines[0].strip() != "---":
        raise PlanError("%s: no frontmatter (first line is not ---)" % rel(path))
    try:
        close = next(i for i in range(1, len(lines)) if lines[i].strip() == "---")
    except StopIteration:
        raise PlanError("%s: frontmatter is never closed" % rel(path))
    rows = []
    for number, raw in enumerate(lines[1:close], start=2):
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        if "\t" in raw[:len(raw) - len(raw.lstrip())]:
            raise PlanError("%s:%d: tab in indentation" % (rel(path), number))
        rows.append((number, len(raw) - len(raw.lstrip(" ")), raw.strip()))
    if not rows:
        return {}, []
    if rows[0][1] != 0:
        raise PlanError("%s:%d: the frontmatter must start at column 0" % (rel(path), rows[0][0]))
    top, end = parse_mapping(path, rows, 0, 0)
    if end < len(rows):
        raise PlanError("%s:%d: cannot parse '%s'" % (rel(path), rows[end][0], rows[end][2]))
    items = []
    for key in ("slices", "items"):
        if key in top:
            items = top.pop(key)
            if items is None:
                items = []
            if not isinstance(items, list) or not all(isinstance(x, dict) for x in items):
                raise PlanError("%s: '%s:' must be a block list of entries" % (rel(path), key))
    return top, items


def is_number(thing):
    return isinstance(thing, (int, float)) and not isinstance(thing, bool)


CHANGE_KINDS = ("added", "extracted", "re-estimated")
CHANGE_FIELDS = ("before_residual_hours", "after_residual_hours", "reason", "date", "decision", "reference",
                 "reconciliation")
RECON_FIELDS = ("id", "date", "reason", "slices", "remaining_before", "completed_residual", "added_scope",
                "explicit_residual_reestimates", "remaining_after")


def public(mapping, fields):
    """A nested record for plan.json: known fields first in contract order, then any other field."""
    result = {}
    for key in fields:
        if key in mapping:
            result[key] = mapping[key]
    for key in mapping:
        if key not in result and not key.startswith("_"):
            result[key] = mapping[key]
    return result


def clean_item(path, item, deferred, schema=None):
    where = "%s:%d" % (rel(path), item["_line"])
    ident = item.get("id")
    if not isinstance(ident, str) or not ident:
        raise PlanError("%s: list item has no id" % where)
    where = "%s (%s)" % (where, ident)
    status = item.get("status")
    if status not in STATUSES:
        raise PlanError("%s: status '%s' is not one of %s" % (where, status, " | ".join(STATUSES)))
    if "hours" in item and "original_hours" not in item:
        raise PlanError("%s: legacy 'hours:' field — migrate it to original_hours and add residual_hours "
                        "(Keel v6.6.0)" % where)
    for key in ("original_hours", "residual_hours"):
        if not is_number(item.get(key)) or item.get(key) < 0:
            raise PlanError("%s: %s '%s' is not a non-negative number" % (where, key, item.get(key)))
    kind = item.get("change_kind")
    if kind not in CHANGE_KINDS:
        raise PlanError("%s: change_kind '%s' is not one of %s" % (where, kind, " | ".join(CHANGE_KINDS)))
    parent = item.get("parent_slice")
    if parent is not None and not isinstance(parent, str):
        raise PlanError("%s: parent_slice must be a slice id or null" % where)
    owns = item.get("owns")
    if not isinstance(owns, list):
        raise PlanError("%s: owns must be an inline list of requirement ids" % where)
    changes = item.get("estimate_changes")
    if changes is None:
        changes = []
    if not isinstance(changes, list) or not all(isinstance(c, dict) for c in changes):
        raise PlanError("%s: estimate_changes must be [] or a block list of records" % where)
    actual = item.get("actual_hours")
    if actual is not None and not is_number(actual):
        raise PlanError("%s: actual_hours '%s' is neither a number nor null" % (where, actual))
    source = item.get("actual_source")
    if source is not None and source not in SOURCES:
        raise PlanError("%s: actual_source '%s' is not one of %s" % (where, source, " | ".join(SOURCES)))
    depends = item.get("depends_on") or []
    criteria = item.get("criteria") or []
    if not isinstance(depends, list) or not isinstance(criteria, list):
        raise PlanError("%s: depends_on and criteria must be inline lists" % where)
    result = {
        "id": ident,
        "title": "" if item.get("title") is None else str(item.get("title")),
        "status": status,
        "original_hours": item["original_hours"],
        "residual_hours": item["residual_hours"],
        "change_kind": kind,
        "parent_slice": parent,
        "owns": [str(x) for x in owns],
        "estimate_changes": [public(c, CHANGE_FIELDS) for c in changes],
    }
    if deferred:
        result["target"] = item.get("target")
        result["reason"] = item.get("reason")
    else:
        result["actual_hours"] = actual
        result["actual_source"] = source
    result["depends_on"] = [str(x) for x in depends]
    result["criteria"] = [str(x) for x in criteria]
    if "execution" in item:
        if schema != "keel.sprint/2":
            raise PlanError("%s: an execution mapping needs schema keel.sprint/2 (this file is %s)" % (where, schema))
        result["execution"] = clean_execution(where, item["execution"])
    return result


EXEC_KEYS = ("write_paths", "contracts", "exclusive_resources", "parallel", "serial_reason")
PARALLEL_MODES = ("eligible", "serial")


def clean_path(where, path):
    if not isinstance(path, str) or not path or "\\" in path or any(c in path for c in "*?["):
        raise PlanError("%s: write_paths entry %r is not a repository path (no globs, no backslashes)" % (where, path))
    if path.startswith("/") or any(part in ("", ".", "..") for part in path.rstrip("/").split("/")):
        raise PlanError("%s: write_paths entry '%s' must be normalised and repository-relative" % (where, path))
    return path


def clean_execution(where, mapping):
    """The closed keel.sprint/2 execution mapping, in contract order."""
    if not isinstance(mapping, dict):
        raise PlanError("%s: execution must be a block mapping" % where)
    unknown = sorted(k for k in mapping if k not in EXEC_KEYS)
    if unknown:
        raise PlanError("%s: execution has unknown key(s) %s" % (where, ", ".join(unknown)))
    paths = mapping.get("write_paths")
    if not isinstance(paths, list) or not paths:
        raise PlanError("%s: execution.write_paths must be a nonempty inline list" % where)
    contracts = mapping.get("contracts")
    if not isinstance(contracts, dict) or sorted(contracts) != ["reads", "writes"]:
        raise PlanError("%s: execution.contracts must be a mapping with exactly reads: and writes:" % where)
    lists = (("contracts.reads", contracts["reads"]), ("contracts.writes", contracts["writes"]),
             ("exclusive_resources", mapping.get("exclusive_resources")))
    for label, values in lists:
        if not isinstance(values, list) or any(not isinstance(v, str) or not v for v in values):
            raise PlanError("%s: execution.%s must be an inline list of names" % (where, label))
    mode = mapping.get("parallel")
    if mode not in PARALLEL_MODES:
        raise PlanError("%s: execution.parallel '%s' is not one of %s" % (where, mode, " | ".join(PARALLEL_MODES)))
    reason = mapping.get("serial_reason")
    if mode == "serial" and (not isinstance(reason, str) or not reason.strip()):
        raise PlanError("%s: a serial slice names its serial_reason" % where)
    if mode == "eligible" and reason is not None:
        raise PlanError("%s: serial_reason must be null on an eligible slice" % where)
    return ordered([
        ("write_paths", [clean_path(where, p) for p in paths]),
        ("contracts", ordered([("reads", list(contracts["reads"])), ("writes", list(contracts["writes"]))])),
        ("exclusive_resources", list(mapping["exclusive_resources"])),
        ("parallel", mode),
        ("serial_reason", reason),
    ])


def clean_reconciliations(path, top):
    records = top.get("scope_reconciliations")
    if records is None:
        return []
    if not isinstance(records, list) or not all(isinstance(r, dict) for r in records):
        raise PlanError("%s: scope_reconciliations must be [] or a block list of records" % rel(path))
    return [dict(public(r, RECON_FIELDS), file=rel(path)) for r in records]


def load():
    sprints = []
    for path in glob.glob(os.path.join(SPRINTS_DIR, "sprint-*.md")):
        top, items = frontmatter(path)
        if top.get("schema") not in SPRINT_SCHEMAS:
            raise PlanError("%s: schema is '%s', expected %s" % (rel(path), top.get("schema"),
                                                                 " or ".join(SPRINT_SCHEMAS)))
        number = top.get("sprint")
        if not isinstance(number, int) or isinstance(number, bool):
            raise PlanError("%s: 'sprint:' is not an integer" % rel(path))
        if top.get("status") not in STATUSES:
            raise PlanError("%s: sprint status '%s' is not one of %s"
                            % (rel(path), top.get("status"), " | ".join(STATUSES)))
        sprints.append({
            "sprint": number,
            "goal": "" if top.get("goal") is None else str(top.get("goal")),
            "status": top.get("status"),
            "file": rel(path),
            "schema": top.get("schema"),
            "slices": [clean_item(path, item, False, top.get("schema")) for item in items],
            "scope_reconciliations": clean_reconciliations(path, top),
        })
    if not sprints:
        raise PlanError("no docs/sprints/sprint-<N>.md file found under %s" % ROOT)
    sprints.sort(key=lambda s: (s["sprint"], s["file"]))
    numbers = [s["sprint"] for s in sprints]
    if len(set(numbers)) != len(numbers):
        raise PlanError("two sprint files declare the same sprint number")
    deferred = []
    if os.path.isfile(DEFERRED):
        top, items = frontmatter(DEFERRED)
        if top.get("schema") != "keel.deferred/1":
            raise PlanError("%s: schema is '%s', expected keel.deferred/1" % (rel(DEFERRED), top.get("schema")))
        deferred = [clean_item(DEFERRED, item, True) for item in items]
    seen = {}
    for sprint in sprints:
        for item in sprint["slices"]:
            if item["id"] in seen:
                raise PlanError("id %s appears twice (%s and %s)" % (item["id"], seen[item["id"]], sprint["file"]))
            seen[item["id"]] = sprint["file"]
    for item in deferred:
        if item["id"] in seen:
            raise PlanError("id %s appears twice (%s and %s)" % (item["id"], seen[item["id"]], rel(DEFERRED)))
        seen[item["id"]] = rel(DEFERRED)
    return sprints, deferred


# --- arithmetic --------------------------------------------------------------

def eligible(item):
    return (item["status"] == "done" and item["actual_source"] == "measured"
            and item["original_hours"] > 0 and is_number(item["actual_hours"]) and item["actual_hours"] >= 0)


def raw_totals(slices, reconciliations):
    live = [s for s in slices if s["status"] != "dropped"]
    done = [s for s in slices if s["status"] == "done"]
    pending = [s for s in slices if s["status"] not in ("done", "dropped")]
    return {
        "estimated": sum(s["original_hours"] for s in live),
        "done": sum(s["original_hours"] for s in done),
        "actual": sum(s["actual_hours"] for s in done if is_number(s["actual_hours"])),
        "remaining": sum(s["residual_hours"] for s in pending),
        "spent_unfinished": sum(s["actual_hours"] for s in pending if is_number(s["actual_hours"])),
        "unreconciled": len([s for s in pending if not s["owns"]]),
        "added_scope": sum(r["added_scope"] for r in reconciliations if is_number(r.get("added_scope"))),
        "extracted": sum(s["original_hours"] for s in live if s["change_kind"] == "extracted"),
        "reestimates": sum(r["explicit_residual_reestimates"] for r in reconciliations
                           if is_number(r.get("explicit_residual_reestimates"))),
        "n_total": len(slices),
        "n_done": len(done),
        "n_pending": len(pending),
        "n_dropped": len(slices) - len(live),
    }


def num(x, places=4):
    if x is None:
        return None
    x = round(float(x), places)
    return int(x) if x == int(x) else x


def block(raw, factor):
    remaining = raw["remaining"]
    if remaining == 0:
        projected = 0
    elif factor is None:
        projected = None
    else:
        projected = remaining * factor
    percent = None if raw["estimated"] == 0 else raw["done"] / float(raw["estimated"]) * 100
    return [
        ("original_estimated_hours", num(raw["estimated"])),
        ("completed_original_hours", num(raw["done"])),
        ("actual_hours", num(raw["actual"])),
        ("remaining_hours", num(remaining)),
        ("deviation_hours", num(raw["actual"] - raw["done"])),
        ("pace_factor", num(factor, 6)),
        ("projected_remaining_hours", num(projected)),
        ("reconciliation_status", "unreconciled" if raw["unreconciled"] else "reconciled"),
        ("scope_delta", ordered([
            ("added_scope_hours", num(raw["added_scope"])),
            ("extracted_hours", num(raw["extracted"])),
            ("explicit_residual_reestimate_hours", num(raw["reestimates"])),
        ])),
        ("percent_done", num(percent, 2)),
        ("unit", UNIT),
        ("spent_unfinished_hours", num(raw["spent_unfinished"])),
        ("slices_total", raw["n_total"]),
        ("slices_done", raw["n_done"]),
        ("slices_pending", raw["n_pending"]),
        ("slices_dropped", raw["n_dropped"]),
        ("slices_unreconciled", raw["unreconciled"]),
    ]


def ordered(pairs):
    # Python 3.7+ dicts keep insertion order; json.dumps then emits it.
    result = {}
    for key, val in pairs:
        result[key] = val
    return result


def slice_record(s, deferred):
    pairs = [
        ("id", s["id"]), ("title", s["title"]), ("status", s["status"]),
        ("original_hours", num(s["original_hours"])), ("residual_hours", num(s["residual_hours"])),
        ("change_kind", s["change_kind"]), ("parent_slice", s["parent_slice"]), ("owns", s["owns"]),
        ("estimate_changes", s["estimate_changes"]),
    ]
    if deferred:
        pairs += [("target", s["target"]), ("reason", s["reason"])]
    else:
        pairs += [("actual_hours", num(s["actual_hours"])), ("actual_source", s["actual_source"])]
    pairs += [("depends_on", s["depends_on"]), ("criteria", s["criteria"])]
    if "execution" in s:
        pairs.append(("execution", s["execution"]))
    return ordered(pairs)


def compute(sprints, deferred):
    every = [s for sprint in sprints for s in sprint["slices"]]
    records = [r for sprint in sprints for r in sprint["scope_reconciliations"]]
    sample = [s for s in every if eligible(s)]
    sample_est = sum(s["original_hours"] for s in sample)
    sample_act = sum(s["actual_hours"] for s in sample)
    factor = (sample_act / float(sample_est)) if sample else None
    current = None
    out_sprints = []
    for sprint in sprints:
        raw = raw_totals(sprint["slices"], sprint["scope_reconciliations"])
        if current is None and raw["n_pending"] > 0:
            current = sprint["sprint"]
        pairs = [("sprint", sprint["sprint"]), ("goal", sprint["goal"]),
                 ("status", sprint["status"]), ("file", sprint["file"])]
        pairs += block(raw, factor)
        pairs.append(("slices", [slice_record(s, False) for s in sprint["slices"]]))
        out_sprints.append(ordered(pairs))
    totals = block(raw_totals(every, records), factor)
    totals.append(("pace_sample", ordered([
        ("slices", len(sample)),
        ("estimated_hours", num(sample_est)),
        ("actual_hours", num(sample_act)),
        ("deviation_hours", num(sample_act - sample_est)),
        ("deviation_percent", num((factor - 1) * 100, 2) if factor is not None else None),
        ("provisional", bool(sample) and len(sample) < PROVISIONAL_BELOW),
    ])))
    sources = [s["file"] for s in sprints]
    if os.path.isfile(DEFERRED):
        sources.append(rel(DEFERRED))
    return ordered([
        ("schema", "keel.plan/2"),
        ("generator", "scripts/keel-plan"),
        ("unit", UNIT),
        ("sources", sources),
        ("current_sprint", current),
        ("reconciliation_status", dict(totals)["reconciliation_status"]),
        ("totals", ordered(totals)),
        ("sprints", out_sprints),
        ("scope_reconciliations", records),
        ("deferred", [slice_record(d, True) for d in deferred]),
    ])


# --- scope-ownership contract (validate) --------------------------------------

def validate(sprints, deferred):
    """(problems, unreconciled): problems fail `validate`; unreconciled lines only label the balance."""
    problems, unreconciled = [], []
    located = []
    for sprint in sprints:
        located += [(sprint["file"], s) for s in sprint["slices"]]
    located += [(rel(DEFERRED), d) for d in deferred]
    by_id = dict((s["id"], s) for _, s in located)
    records = {}
    for sprint in sprints:
        for r in sprint["scope_reconciliations"]:
            label = "%s scope_reconciliations %s" % (r["file"], r.get("id"))
            if not isinstance(r.get("id"), str):
                problems.append("%s: a scope_reconciliations record has no id" % r["file"])
                continue
            if r["id"] in records:
                problems.append("%s: reconciliation id is used twice" % label)
            records[r["id"]] = r
            terms = ("remaining_before", "completed_residual", "added_scope", "explicit_residual_reestimates",
                     "remaining_after")
            missing = [t for t in terms if not is_number(r.get(t))]
            if missing:
                problems.append("%s: %s must be numbers" % (label, ", ".join(missing)))
            else:
                want = (r["remaining_before"] - r["completed_residual"] + r["added_scope"]
                        + r["explicit_residual_reestimates"])
                if abs(want - r["remaining_after"]) > 0.005:
                    problems.append("%s: balance does not hold — %g - %g + %g + %g = %g, recorded remaining_after %g"
                                    % (label, r["remaining_before"], r["completed_residual"], r["added_scope"],
                                       r["explicit_residual_reestimates"], want, r["remaining_after"]))
            if not r.get("reason") or not r.get("date"):
                problems.append("%s: reason and date are required" % label)
            listed = r.get("slices")
            if not isinstance(listed, list) or not listed:
                problems.append("%s: slices must list the affected slice ids" % label)
            else:
                for ident in listed:
                    if ident not in by_id:
                        problems.append("%s: lists %s, which is in no sprint file or deferred.md" % (label, ident))
    owners = {}
    for where, s in located:
        label = "%s (%s)" % (where, s["id"])
        closed = s["status"] in ("done", "dropped")
        if closed and s["residual_hours"] != 0:
            problems.append("%s: is %s with residual_hours %g — a closed slice has no unbuilt scope"
                            % (label, s["status"], s["residual_hours"]))
        if s["change_kind"] == "extracted":
            parent = s["parent_slice"]
            if not parent:
                problems.append("%s: change_kind extracted without parent_slice" % label)
            elif parent not in by_id:
                problems.append("%s: parent_slice %s does not exist" % (label, parent))
            elif parent == s["id"]:
                problems.append("%s: a slice cannot be its own parent" % label)
            if not s["owns"]:
                problems.append("%s: an extracted slice must own the requirements it took from its parent" % label)
            if parent and not any(isinstance(r.get("slices"), list) and s["id"] in r["slices"] and parent in r["slices"]
                                  for r in records.values()):
                problems.append("%s: no scope_reconciliations record lists both %s and its parent %s — the "
                                "extraction was not reconciled in the same checkpoint" % (label, s["id"], parent))
        elif s["parent_slice"]:
            problems.append("%s: parent_slice is set but change_kind is %s (only extracted slices have a parent)"
                            % (label, s["change_kind"]))
        if s["status"] != "dropped":
            for req in s["owns"]:
                if req in owners and owners[req] != s["id"]:
                    problems.append("%s: owns %s, which %s already owns — counted slices own requirements "
                                    "exclusively" % (label, req, owners[req]))
                owners.setdefault(req, s["id"])
        if not closed and not s["owns"]:
            unreconciled.append("%s: open slice owns no requirement — the balance is unreconciled" % label)
        expected = s["original_hours"]
        for n, c in enumerate(s["estimate_changes"], start=1):
            tag = "%s estimate_changes #%d" % (label, n)
            before, after = c.get("before_residual_hours"), c.get("after_residual_hours")
            if not is_number(before) or not is_number(after) or after < 0:
                problems.append("%s: before_residual_hours / after_residual_hours must be non-negative numbers" % tag)
                expected = None
                continue
            if expected is not None and abs(before - expected) > 0.005:
                problems.append("%s: before_residual_hours %g does not continue from %g (records are append-only)"
                                % (tag, before, expected))
            expected = after
            if not c.get("reason") or not c.get("date") or not (c.get("decision") or c.get("reference")):
                problems.append("%s: reason, date and decision (or reference) are required" % tag)
            rid = c.get("reconciliation")
            if not rid:
                problems.append("%s: names no reconciliation record written in the same checkpoint" % tag)
            elif rid not in records:
                problems.append("%s: reconciliation %s does not exist" % (tag, rid))
            elif s["id"] not in (records[rid].get("slices") or []):
                problems.append("%s: reconciliation %s does not list %s" % (tag, rid, s["id"]))
        if not closed and expected is not None and abs(s["residual_hours"] - expected) > 0.005:
            if s["estimate_changes"]:
                problems.append("%s: residual_hours %g differs from the last estimate_changes record (%g)"
                                % (label, s["residual_hours"], expected))
            else:
                problems.append("%s: residual_hours %g differs from original_hours %g with no estimate_changes "
                                "record" % (label, s["residual_hours"], s["original_hours"]))
    return problems, unreconciled


def parallel_problems(sprints, text):
    """Run scripts/keel-parallel validate over the generated plan (one implementation of its rules)."""
    helper = os.path.join(ROOT, "scripts", "keel-parallel")
    if not any(s["schema"] == "keel.sprint/2" for s in sprints) or not os.path.isfile(helper):
        return []
    import subprocess
    import tempfile
    handle, scratch = tempfile.mkstemp(suffix=".json")
    try:
        with io.open(handle, "w", encoding="utf-8") as fh:
            fh.write(text)
        proc = subprocess.run([sys.executable, helper, "validate", "--plan", scratch],
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    finally:
        os.unlink(scratch)
    if proc.returncode == 0:
        return []
    message = (proc.stdout + proc.stderr).decode("utf-8", "replace").strip()
    try:
        message = json.loads(message).get("error", message)
    except ValueError:
        pass
    return ["scripts/keel-parallel validate refuses the generated plan: %s" % message]


def serialise(plan):
    return json.dumps(plan, indent=2, ensure_ascii=False) + "\n"


# --- display -----------------------------------------------------------------

def h(x, places=2):
    """A number for display: rounded, no trailing zeros."""
    x = round(float(x), places)
    if x == 0:
        x = 0.0
    text = ("%." + str(places) + "f") % x
    text = text.rstrip("0").rstrip(".") if "." in text else text
    return text.replace("-", MINUS)


def signed(x, places=2):
    text = h(x, places)
    return text if text.startswith(MINUS) else "+" + text


def plural(n, word):
    return "%d %s%s" % (n, word, "" if n == 1 else "s")


def cell(text):
    return str(text).replace("|", "\\|")


def index_table(plan):
    t = plan["totals"]

    def opt(x, places=2):
        return DASH if x is None else h(x, places)

    lines = [
        BEGIN,
        "<!-- Generated by scripts/keel-plan build from the sprint frontmatter. Do not edit between the markers. -->",
        "",
        "| Sprint | Goal | Status | Slices done | Original h | Done (original) h | Actual h | Left (residual) h | Projected left h | % done |",
        "|---|---|---|---|---|---|---|---|---|---|",
    ]
    for s in plan["sprints"]:
        lines.append("| [%d](sprint-%d.md) | %s | %s | %d / %d | %s | %s | %s | %s | %s | %s |" % (
            s["sprint"], s["sprint"], cell(s["goal"]), s["status"],
            s["slices_done"], s["slices_total"] - s["slices_dropped"],
            h(s["original_estimated_hours"]), h(s["completed_original_hours"]), h(s["actual_hours"]),
            h(s["remaining_hours"]), opt(s["projected_remaining_hours"]), opt(s["percent_done"], 1)))
    lines.append("| **Total** | | | %d / %d | %s | %s | %s | %s | %s | %s |" % (
        t["slices_done"], t["slices_total"] - t["slices_dropped"],
        h(t["original_estimated_hours"]), h(t["completed_original_hours"]), h(t["actual_hours"]),
        h(t["remaining_hours"]), opt(t["projected_remaining_hours"]), opt(t["percent_done"], 1)))
    lines.append("")
    sample = t["pace_sample"]
    if t["pace_factor"] is None:
        pace = "Pace factor: unavailable %s no measured completed work." % DASH
    else:
        pace = "Pace factor: %s (%s%s)." % (
            h(t["pace_factor"], 4), plural(sample["slices"], "measured slice"),
            ", provisional sample" if sample["provisional"] else "")
    deferred_hours = sum(d["residual_hours"] for d in plan["deferred"])
    lines.append(
        "All figures are %s. Contingency is not included, and neither is the backlog in "
        "[`deferred.md`](deferred.md) (%s, %s h). %s Balance: %s."
        % (UNIT, plural(len(plan["deferred"]), "item"), h(deferred_hours), pace, t["reconciliation_status"]))
    lines.append(END)
    return "\n".join(lines)


def readme_with_table(plan):
    table = index_table(plan)
    text = read(README).replace("\r\n", "\n") if os.path.isfile(README) else "# Sprints\n"
    start, stop = text.find(BEGIN), text.find(END)
    if start != -1 and stop != -1 and stop > start:
        return text[:start] + table + text[stop + len(END):]
    if not text.endswith("\n"):
        text += "\n"
    return text + "\n" + table + "\n"


def left_block(plan):
    t = plan["totals"]
    lines = []
    first = True
    for s in plan["sprints"]:
        pending = [x for x in s["slices"] if x["status"] not in ("done", "dropped")]
        if not pending:
            continue
        if first:
            first = False
            lines.append("Sprint %d %s %s: %s pending, %s h left" % (
                s["sprint"], DASH, s["goal"], plural(len(pending), "slice"), h(s["remaining_hours"])))
            for x in pending:
                spent = ""
                if x["actual_hours"] is not None:
                    spent = " (%s h spent so far)" % h(x["actual_hours"])
                lines.append("  %s %s %s %s h residual%s" % (x["id"], x["title"], DASH, h(x["residual_hours"]), spent))
        else:
            lines.append("Sprint %d %s %s: %s h" % (s["sprint"], DASH, s["goal"], h(s["remaining_hours"])))
    lines.append("Total left: %s h of AI working time plus supervision (contingency not included; %s)"
                 % (h(t["remaining_hours"]), t["reconciliation_status"]))
    if t["completed_original_hours"]:
        pct = ", %s %%" % signed(t["deviation_hours"] / float(t["completed_original_hours"]) * 100, 1)
    else:
        pct = ""
    lines.append("So far: %s done, %s h estimated, %s h actual (%s h%s)" % (
        plural(t["slices_done"], "slice"), h(t["completed_original_hours"]), h(t["actual_hours"]),
        signed(t["deviation_hours"]), pct))
    sample = t["pace_sample"]
    if t["remaining_hours"] == 0:
        tail = "0 h left"
        if t["pace_factor"] is not None:
            tail += " (factor %s; %s)" % (h(t["pace_factor"], 4), plural(sample["slices"], "measured slice"))
    elif t["pace_factor"] is None:
        tail = "unavailable %s no measured completed work" % DASH
    else:
        tail = "%s h left (factor %s; %s%s)" % (
            h(t["projected_remaining_hours"]), h(t["pace_factor"], 4),
            plural(sample["slices"], "measured slice"),
            ", provisional sample" if sample["provisional"] else "")
    lines.append("Projection if the observed pace continues: " + tail)
    return "\n".join(lines) + "\n"


# --- check -------------------------------------------------------------------

def differences(want, have, path="", found=None):
    found = [] if found is None else found
    if isinstance(want, dict) and isinstance(have, dict):
        for key in want:
            if key not in have:
                found.append("%s/%s: missing in plan.json (sources give %s)"
                             % (path, key, json.dumps(want[key], ensure_ascii=False)[:80]))
            else:
                differences(want[key], have[key], "%s/%s" % (path, key), found)
        for key in have:
            if key not in want:
                found.append("%s/%s: in plan.json but not produced by the sources" % (path, key))
    elif isinstance(want, list) and isinstance(have, list):
        if len(want) != len(have):
            found.append("%s: plan.json has %d entries, sources give %d" % (path, len(have), len(want)))
        for i in range(min(len(want), len(have))):
            label = want[i].get("id", want[i].get("sprint", i)) if isinstance(want[i], dict) else i
            differences(want[i], have[i], "%s[%s]" % (path, label), found)
    elif want != have or type(want) != type(have):
        found.append("%s: plan.json has %s, sources give %s"
                     % (path, json.dumps(have, ensure_ascii=False), json.dumps(want, ensure_ascii=False)))
    return found


def write_if_changed(path, text):
    if os.path.isfile(path) and read(path) == text:
        return False
    folder = os.path.dirname(path)
    if not os.path.isdir(folder):
        os.makedirs(folder)
    temp = path + ".tmp"
    with io.open(temp, "w", encoding="utf-8", newline="") as fh:
        fh.write(text)
    os.rename(temp, path)
    return True


def main():
    sprints, deferred = load()
    plan = compute(sprints, deferred)
    text = serialise(plan)

    if CMD == "json":
        out(text)
        return 0

    if CMD == "validate":
        problems, unreconciled = validate(sprints, deferred)
        problems += parallel_problems(sprints, text)
        for item in unreconciled:
            out("UNRECONCILED: %s\n" % item)
        for sprint in sprints:
            if sprint["schema"] != "keel.sprint/2":
                continue
            for s in sprint["slices"]:
                if s["status"] not in ("done", "dropped") and "execution" not in s:
                    out("UNMAPPED: %s (%s): open keel.sprint/2 slice with no execution mapping %s unknown, "
                        "never dispatched\n" % (sprint["file"], s["id"], DASH))
        for item in problems:
            out("INVALID: %s\n" % item)
        if problems:
            out("keel-plan validate: FAIL %s %s\n" % (DASH, plural(len(problems), "problem")))
            return 1
        out("keel-plan validate: OK %s ownership exclusive, residual changes recorded, every balance holds "
            "(%s)\n" % (DASH, plan["reconciliation_status"]))
        return 0

    if CMD == "left":
        out(left_block(plan))
        return 0

    if CMD == "build":
        changed_plan = write_if_changed(PLAN, text)
        changed_readme = write_if_changed(README, readme_with_table(plan))
        t = plan["totals"]
        out("keel-plan: %s %s (%d sprints, %d slices, %s h original, %s h residual left)\n" % (
            rel(PLAN), "written" if changed_plan else "unchanged", len(plan["sprints"]),
            t["slices_total"], h(t["original_estimated_hours"]), h(t["remaining_hours"])))
        out("keel-plan: %s index table %s\n" % (rel(README), "written" if changed_readme else "unchanged"))
        return 0

    # check
    problems = []
    if not os.path.isfile(PLAN):
        problems.append("%s does not exist" % rel(PLAN))
    else:
        current = read(PLAN)
        if current != text:
            try:
                found = differences(plan, json.loads(current))
            except ValueError as error:
                found = ["%s is not valid JSON (%s)" % (rel(PLAN), error)]
            if not found:
                found = ["%s differs from the generated output in formatting only" % rel(PLAN)]
            problems.extend("%s %s" % (rel(PLAN), item) if item.startswith("/") else item for item in found)
    if not os.path.isfile(README):
        problems.append("%s does not exist" % rel(README))
    else:
        current = read(README).replace("\r\n", "\n")
        if BEGIN not in current or END not in current:
            problems.append("%s has no keel-plan index markers" % rel(README))
        elif current != readme_with_table(plan):
            want = index_table(plan).split("\n")
            have = current[current.find(BEGIN):current.find(END) + len(END)].split("\n")
            named = False
            for i in range(max(len(want), len(have))):
                a = want[i] if i < len(want) else "(no line)"
                b = have[i] if i < len(have) else "(no line)"
                if a != b:
                    problems.append("%s index table line %d: has '%s', sources give '%s'"
                                    % (rel(README), i + 1, b, a))
                    named = True
                    break
            if not named:
                problems.append("%s index table differs from the generated output" % rel(README))
    if problems:
        for item in problems:
            out("DRIFT: %s\n" % item)
        out("keel-plan check: FAIL %s run scripts/keel-plan build\n" % DASH)
        return 1
    out("keel-plan check: OK %s %s and the index table match the sources\n" % (DASH, rel(PLAN)))
    return 0


try:
    sys.exit(main())
except PlanError as error:
    sys.stderr.write("keel-plan: %s\n" % error)
    sys.exit(2)
