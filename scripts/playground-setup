#!/usr/bin/env bash
# Seed of a playground site on the shared VM keel-development (docs/playground.md,
# "One-time environment setup"; D-114). Idempotent: safe to re-run. `scripts/keel-site
# reset` runs it; KEEL_SITE selects the site (wrgl = floor, the default; wrgl-ceiling).
#
# The gateway secret below is Redsys's public generic test key (D-042).
set -u

PLUGIN="woo-redsys-gateway-light"
TEST_KEY="sq7HjrUOBfKmC576ILgskD5srU870gJ7"
SITE="${KEEL_SITE:-wrgl}"

wp() { "$(dirname "$0")/keel-site" --site "$SITE" wp "$@" 2>/dev/null; }
step() { echo "playground-setup [$SITE]: $*"; }
die() { echo "playground-setup [$SITE]: FAILED — $*" >&2; exit 1; }

# WooCommerce first: the plugin's `Requires Plugins` header refuses otherwise.
wp plugin activate woocommerce "$PLUGIN" >/dev/null || die "could not activate $PLUGIN (scripts/keel-site doctor)"
step "plugin active"

[ -x vendor/bin/phpunit ] || die "PHPUnit is not in vendor/ — run composer install on the host (the VM reads vendor/ through the share)"

wp rewrite structure '/%postname%/' >/dev/null || die "permalinks"
wp rewrite flush --hard >/dev/null
step "pretty permalinks set"

# The checkout specs add post ID 10 to the cart, so the test product must be
# the first thing created on a fresh install (IDs 1-9 are taken by defaults).
if ! wp post list --post_type=product --name=test-product --format=ids | grep -q '[0-9]'; then
	wp wc product create --user=1 --name="Test Product" --type=simple --regular_price=10 --porcelain >/dev/null || die "Test Product"
fi
TEST_ID=$(wp post list --post_type=product --name=test-product --format=ids | tr -d '[:space:]')
[ "$TEST_ID" = "10" ] || die "Test Product has ID '$TEST_ID', the e2e specs expect 10 — rebuild the site: scripts/keel-site --site $SITE retire && scripts/keel-site --site $SITE create"
step "Test Product is post 10"

if ! wp post list --post_type=product --name=e2e-transaction-limit-product --format=ids | grep -q '[0-9]'; then
	wp wc product create --user=1 --name="E2E Transaction Limit Product" --type=simple --regular_price=200.50 --porcelain >/dev/null || die "limit product"
fi
# The self-closing form of the block renders nothing on the pinned
# WooCommerce 7.4 (Blocks 9.4.3): it needs its wrapper element.
BLOCKS_CONTENT='<!-- wp:woocommerce/checkout --><div class="wp-block-woocommerce-checkout"></div><!-- /wp:woocommerce/checkout -->'
BLOCKS_ID=$(wp post list --post_type=page --name=checkout-blocks --format=ids | tr -d '[:space:]')
if [ -z "$BLOCKS_ID" ]; then
	wp post create --post_type=page --post_title="Checkout Blocks" --post_name="checkout-blocks" \
		--post_status=publish --post_content="$BLOCKS_CONTENT" >/dev/null || die "Blocks checkout page"
else
	wp post update "$BLOCKS_ID" --post_content="$BLOCKS_CONTENT" >/dev/null || die "Blocks checkout page"
fi
step "limit product and Blocks checkout page present"

# Current WooCommerce creates the checkout page with the Checkout block and
# starts the store in "coming soon" mode; the classic-checkout specs need the
# shortcode page and a store guests can reach. Both lines change nothing on
# the pinned WooCommerce 7.4.
CHECKOUT_ID=$(wp option get woocommerce_checkout_page_id | tr -d '[:space:]')
[ -n "$CHECKOUT_ID" ] || die "no checkout page"
wp post update "$CHECKOUT_ID" --post_content='<!-- wp:shortcode -->[woocommerce_checkout]<!-- /wp:shortcode -->' >/dev/null || die "classic checkout page"
wp option update woocommerce_coming_soon no >/dev/null
step "classic checkout page set; store open to guests"

wp option update woocommerce_redsys_settings --format=json \
	'{"enabled":"yes","title":"Redsys","description":"Pay with card via Redsys","customer":"999008881","commercename":"Test Shop","payoptions":"T","terminal":"1","not_use_https":"no","lwvactive":"no","orderdo":"processing","secretsha256":"'"$TEST_KEY"'","customtestsha256":"","redsyslanguage":"002","testmode":"yes","debug":"no"}' >/dev/null || die "redsys settings"
wp option update woocommerce_bizumredsys_settings --format=json \
	'{"enabled":"yes","title":"Bizum","description":"Pay via Bizum you can pay with your Bizum account.","customer":"999008881","commercename":"Test Shop","terminal":"1","orderdo":"processing","not_use_https":"no","secretsha256":"'"$TEST_KEY"'","customtestsha256":"","redsyslanguage":"002","testmode":"yes","debug":"no"}' >/dev/null || die "bizum settings"
wp option update woocommerce_googlepayredirecredsys_settings --format=json \
	'{"enabled":"yes","title":"Google Pay","description":"Pay via GPay you can pay with your Google account.","customer":"999008881","commercename":"Test Shop","terminal":"1","not_use_https":"no","secretsha256":"'"$TEST_KEY"'","customtestsha256":"","redsyslanguage":"002","testmode":"yes","testshowgateway":[""],"debug":"no"}' >/dev/null || die "googlepay settings"
wp option update redsyslite_e2e_stub_inespay yes >/dev/null
wp option update woocommerce_inespayredsys_settings --format=json \
	'{"enabled":"yes","title":"Inespay Bank Transfer","description":"Pay via instant bank transfer.","api_key":"e2e-test-api-key","api_token":"e2e-test-api-token","testmode":"yes","transactionlimit":"200","debug":"no"}' >/dev/null || die "inespay settings"
step "four gateways configured (test mode); Inespay HTTP stub on"

echo "playground-setup [$SITE]: done"
