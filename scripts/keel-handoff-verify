#!/usr/bin/env bash
#
# keel-handoff-verify — the mechanical courier checks over
# docs/continuation-prompt.md, per Keel's references/project-state.md
# ("The continuation file"). A session NEVER composes these checks inline —
# it always runs this script, because inline `$(...)` nesting breaks the
# permission matcher (see the reference for why).
#
# Checks, in this order (containment first — it is the only one that
# catches a second checkout of the SAME repository):
#   1. Containment — the hand-off file's real path is inside this session's
#      `git rev-parse --show-toplevel`.
#   2. Repo — the header's `Repo:` short hash against this repo's root
#      commit (`git rev-list --max-parents=0 HEAD | sort | head -1`).
#   3. Commit — the header's `Commit:` against `git rev-parse HEAD`. A
#      hand-off naming an ancestor of HEAD is STALE: the row FAILS and says
#      how far behind it is. (With .githooks/post-commit active this state
#      cannot be produced — committing deletes the hand-off — so the row
#      failing also means the hook is not doing its job.)
#   4. Generated — parses as a valid epoch/timestamp.
#   5. Tree — the header's `Tree:` (clean / dirty (N files)) against the
#      live `git status --porcelain`.
#   6. Branch — the header's `Branch:` against the current branch, and any
#      "pushed" claim against `git rev-list @{u}..HEAD`.
# `Mode:` (the card's Autonomy/Chaining carried in the hand-off) is CARRIED,
# not checked: it is printed beside the card's own values, and the card wins.
# `Position:` is prose and is not a mechanical check.
#
# Prints one line per check, then VERDICT: CONTINUE or VERDICT: STOP.
#
# On a clean VERDICT: CONTINUE, if the project card (docs/PROGRESS.md)
# says `Chaining: start`, this script ALSO claims the single-lane lock —
# see "Single-lane lock" below. On any other Chaining value the lock is
# never touched.
#
# Options:
#   --release   releases the single-lane lock, idempotently, and only when
#               THIS session is the recorded owner. Exits 0 either way.
#   --no-lane   runs the checks and prints the verdict but never touches the
#               lane. For callers that verify without ARRIVING: the launcher
#               (scripts/keel-continue) and the stop hook, which must not
#               re-take a lane their session has just handed back.
#   --lane      prints the lane's state and changes nothing:
#               `Lane: free` / `Lane: held by this session (...)` /
#               `Lane: BUSY (...)` / `Lane: orphaned (...)`.
#
# A missing docs/continuation-prompt.md is NOT an error: it means resume
# normally from docs/PROGRESS.md (the file is gitignored, so a fresh clone
# never has one).
#
# --- Single-lane lock — who is "this session"? -----------------------------
# This script runs as a SUBPROCESS of the session's long-lived process; its
# own PID and its parent shell's are transient. The identity the lock needs
# is the SESSION's, and it comes from scripts/keel-session-pid.sh
# (keel_session_pid) — sourced, never re-implemented here — as
# "<pid>-<start>". Where no session process is found the helper falls back
# to the immediate parent, which can only make this script OVER-cautious
# (a same-session reclaim read as an orphan recovery); it can never mistake
# an unrelated live process for the owner.
#
# State lives OUTSIDE the repository: ${KEEL_STATE_DIR:-${TMPDIR:-/tmp}}.

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
	echo "Not inside a git repository — cannot run the courier checks."
	exit 1
fi
cd "$REPO_ROOT" || exit 1

HANDOFF="$REPO_ROOT/docs/continuation-prompt.md"
STATE_ROOT="${KEEL_STATE_DIR:-${TMPDIR:-/tmp}}"
STATE_ROOT="${STATE_ROOT%/}"
STATE_DIR="$STATE_ROOT/keel-locks"
mkdir -p "$STATE_DIR" 2>/dev/null

MODE="verify"
case "${1:-}" in
--release) MODE="release" ;;
--no-lane) MODE="no-lane" ;;
--lane) MODE="lane" ;;
"") ;;
*)
	echo "Unknown option '$1' — usage: keel-handoff-verify [--release | --no-lane | --lane]"
	exit 2
	;;
esac

# The project's one answer to "who am I".
if [ -f "$REPO_ROOT/scripts/keel-session-pid.sh" ]; then
	# shellcheck source=scripts/keel-session-pid.sh
	. "$REPO_ROOT/scripts/keel-session-pid.sh"
else
	keel_session_pid() {
		printf '%s-%s\n' "$PPID" "$(LC_ALL=C ps -o lstart= -p "$PPID" 2>/dev/null | tr -cd 'A-Za-z0-9')"
		return 1
	}
fi
SELF_SESSION=$(keel_session_pid)
SELF_PID="${SELF_SESSION%%-*}"

# --- Portable epoch helpers (macOS/BSD date vs GNU date) -------------------
iso_to_epoch() {
	local ts="$1"
	if date -d "$ts" +%s >/dev/null 2>&1; then
		date -d "$ts" +%s
		return 0
	fi
	local ts_bsd
	ts_bsd=$(printf '%s' "$ts" | sed -E 's/([+-][0-9]{2}):([0-9]{2})$/\1\2/')
	if date -j -f "%Y-%m-%dT%H:%M:%S%z" "$ts_bsd" +%s >/dev/null 2>&1; then
		date -j -f "%Y-%m-%dT%H:%M:%S%z" "$ts_bsd" +%s
		return 0
	fi
	return 1
}

file_mtime_epoch() {
	local f="$1"
	if stat -f %m "$f" >/dev/null 2>&1; then
		stat -f %m "$f"
		return 0
	fi
	if stat -c %Y "$f" >/dev/null 2>&1; then
		stat -c %Y "$f"
		return 0
	fi
	return 1
}

sha256_of() {
	printf '%s' "$1" | shasum -a 256 2>/dev/null | awk '{print $1}'
}

# --- Single-lane lock helpers -----------------------------------------------
pid_is_alive() {
	kill -0 "$1" 2>/dev/null
}

pid_start_time() {
	LC_ALL=C ps -o lstart= -p "$1" 2>/dev/null | tr -s ' '
}

# The same instant as this shell's own locale prints it — locks written before
# the start time was pinned to the C locale recorded this form.
pid_start_time_locale() {
	ps -o lstart= -p "$1" 2>/dev/null | tr -s ' '
}

# Is the recorded holder still the same live process?
holder_is_live() {
	local pid="$1" recorded="$2" live
	[ -n "$pid" ] || return 1
	pid_is_alive "$pid" || return 1
	live=$(pid_start_time "$pid")
	[ "$live" = "$recorded" ] && return 0
	live=$(pid_start_time_locale "$pid")
	[ "$live" = "$recorded" ] && return 0
	return 1
}

write_lock() {
	{
		echo "pid=$SELF_PID"
		echo "start_time=$(pid_start_time "$SELF_PID")"
		echo "session=$SELF_SESSION"
	} >"$1"
}

lock_file_path() {
	echo "$STATE_DIR/$(sha256_of "$REPO_ROOT").lock"
}

# ---------------------------------------------------------------------------
if [ "$MODE" = "release" ]; then
	LOCK_FILE=$(lock_file_path)
	if [ ! -f "$LOCK_FILE" ]; then
		echo "Nothing to release — no lane held for $REPO_ROOT."
		exit 0
	fi
	RECORDED_PID=$(grep -m1 '^pid=' "$LOCK_FILE" 2>/dev/null | cut -d= -f2-)
	if [ "$RECORDED_PID" = "$SELF_PID" ]; then
		rm -f "$LOCK_FILE"
		echo "Lane released for $REPO_ROOT (was held by PID $RECORDED_PID, this session)."
	else
		echo "Lane for $REPO_ROOT is held by PID $RECORDED_PID, not this session (PID $SELF_PID) — not releasing someone else's lane."
	fi
	exit 0
fi

if [ "$MODE" = "lane" ]; then
	LOCK_FILE=$(lock_file_path)
	if [ ! -f "$LOCK_FILE" ]; then
		echo "Lane: free — no lane held for $REPO_ROOT"
		exit 0
	fi
	RECORDED_PID=$(grep -m1 '^pid=' "$LOCK_FILE" 2>/dev/null | cut -d= -f2-)
	RECORDED_START=$(grep -m1 '^start_time=' "$LOCK_FILE" 2>/dev/null | cut -d= -f2-)
	if ! holder_is_live "$RECORDED_PID" "$RECORDED_START"; then
		echo "Lane: orphaned (PID $RECORDED_PID is gone or was reused) — the next arriving session recovers it"
	elif [ "$RECORDED_PID" = "$SELF_PID" ]; then
		echo "Lane: held by this session (PID $SELF_PID)"
	else
		echo "Lane: BUSY (PID $RECORDED_PID, started $RECORDED_START) — close that window, or run 'scripts/keel-handoff-verify --release' inside it, to free the lane"
	fi
	exit 0
fi

# ---------------------------------------------------------------------------
if [ ! -f "$HANDOFF" ]; then
	echo "no docs/continuation-prompt.md — nothing to verify (this is ordinary: the file is gitignored, resume from docs/PROGRESS.md)"
	exit 0
fi

STOP=0

# --- 1. Containment ----------------------------------------------------
REAL_HANDOFF=$(cd "$(dirname "$HANDOFF")" 2>/dev/null && pwd -P)/$(basename "$HANDOFF")
case "$REAL_HANDOFF" in
"$REPO_ROOT"/*)
	echo "Containment: OK — $HANDOFF is inside $REPO_ROOT"
	;;
*)
	echo "Containment: FAIL — $HANDOFF resolves outside $REPO_ROOT"
	STOP=1
	;;
esac

# Parse the freshness header (the block between the first two '---' lines).
HEADER=$(awk '/^---$/{n++; next} n==1{print} n>=2{exit}' "$HANDOFF")
HDR_REPO=$(printf '%s\n' "$HEADER" | grep -m1 '^Repo:' | sed -E 's/^Repo:[[:space:]]*//')
HDR_COMMIT=$(printf '%s\n' "$HEADER" | grep -m1 '^Commit:' | sed -E 's/^Commit:[[:space:]]*//')
HDR_GENERATED=$(printf '%s\n' "$HEADER" | grep -m1 '^Generated:' | sed -E 's/^Generated:[[:space:]]*//')
HDR_TREE=$(printf '%s\n' "$HEADER" | grep -m1 '^Tree:' | sed -E 's/^Tree:[[:space:]]*//')
HDR_HANDOVER=$(printf '%s\n' "$HEADER" | grep -m1 '^Handover:' | sed -E 's/^Handover:[[:space:]]*//')
HDR_BRANCH=$(printf '%s\n' "$HEADER" | grep -m1 '^Branch:' | sed -E 's/^Branch:[[:space:]]*//')
HDR_MODE=$(printf '%s\n' "$HEADER" | grep -m1 '^Mode:' | sed -E 's/^Mode:[[:space:]]*//')

# --- 2. Repo -------------------------------------------------------------
IS_SHALLOW=$(git rev-parse --is-shallow-repository 2>/dev/null)
if [ "$IS_SHALLOW" = "true" ]; then
	if [ "$HDR_REPO" = "unavailable (shallow)" ]; then
		echo "Repo: unavailable (shallow) — identity unverifiable, relying on containment"
	else
		echo "Repo: FAIL — this is a shallow clone but the hand-off does not say 'unavailable (shallow)' (got '$HDR_REPO')"
		STOP=1
	fi
else
	ROOT_COMMIT_FULL=$(git rev-list --max-parents=0 HEAD 2>/dev/null | sort | head -1)
	if [ -z "$HDR_REPO" ]; then
		echo "Repo: FAIL — no 'Repo:' line found in the hand-off header"
		STOP=1
	elif [ -z "$ROOT_COMMIT_FULL" ]; then
		echo "Repo: FAIL — could not determine this repository's root commit"
		STOP=1
	else
		HDR_LEN=${#HDR_REPO}
		ROOT_SHORT="${ROOT_COMMIT_FULL:0:$HDR_LEN}"
		if [ "$HDR_REPO" = "$ROOT_SHORT" ]; then
			echo "Repo: OK — $HDR_REPO matches this repository's root commit"
		else
			echo "Repo: FAIL — hand-off says '$HDR_REPO', this repository's root commit is '$ROOT_SHORT' (this hand-off belongs to another repository)"
			STOP=1
		fi
	fi
fi

# --- 3. Commit — the hand-off must describe HEAD ------------------------
CURRENT_HEAD=$(git rev-parse HEAD 2>/dev/null)
if [ -z "$HDR_COMMIT" ]; then
	echo "Commit: FAIL — no 'Commit:' line found in the hand-off header"
	STOP=1
elif [ -z "$CURRENT_HEAD" ]; then
	echo "Commit: FAIL — could not determine current HEAD"
	STOP=1
else
	if git rev-parse --verify "${HDR_COMMIT}" >/dev/null 2>&1; then
		RESOLVED=$(git rev-parse "${HDR_COMMIT}" 2>/dev/null)
		if [ "$RESOLVED" = "$CURRENT_HEAD" ]; then
			echo "Commit: OK — $HDR_COMMIT is the current HEAD"
		elif git merge-base --is-ancestor "$RESOLVED" "$CURRENT_HEAD" 2>/dev/null; then
			BEHIND=$(git rev-list --count "${RESOLVED}..${CURRENT_HEAD}" 2>/dev/null)
			echo "Commit: FAIL — $HDR_COMMIT is $BEHIND commit(s) behind current HEAD ($CURRENT_HEAD); the repository moved on since the hand-off was written (stale — resume from docs/PROGRESS.md)"
			STOP=1
		else
			echo "Commit: FAIL — $HDR_COMMIT is not an ancestor of current HEAD ($CURRENT_HEAD); histories have diverged"
			STOP=1
		fi
	else
		echo "Commit: FAIL — '$HDR_COMMIT' does not resolve to a commit in this repository"
		STOP=1
	fi
fi

# --- 4. Generated ----------------------------------------------------
if [ -z "$HDR_GENERATED" ]; then
	echo "Generated: FAIL — no 'Generated:' line found in the hand-off header"
	STOP=1
else
	GEN_EPOCH=$(iso_to_epoch "$HDR_GENERATED")
	if [ -z "$GEN_EPOCH" ]; then
		echo "Generated: FAIL — '$HDR_GENERATED' does not parse as a valid timestamp"
		STOP=1
	else
		NOW_EPOCH=$(date +%s)
		MTIME_EPOCH=$(file_mtime_epoch "$HANDOFF")
		AGE=$((NOW_EPOCH - GEN_EPOCH))
		echo "Generated: OK — $HDR_GENERATED parses as epoch $GEN_EPOCH (age: ${AGE}s; file mtime epoch: ${MTIME_EPOCH:-unknown})"
	fi
fi

# --- 5. Tree -------------------------------------------------------------
if [ -z "$HDR_TREE" ]; then
	echo "Tree: FAIL — no 'Tree:' line found in the hand-off header"
	STOP=1
else
	PORCELAIN=$(git status --porcelain 2>/dev/null)
	if [ -z "$PORCELAIN" ]; then
		LIVE_TREE="clean"
	else
		N=$(printf '%s\n' "$PORCELAIN" | grep -c .)
		LIVE_TREE="dirty ($N files)"
	fi
	if [ "$HDR_TREE" = "$LIVE_TREE" ]; then
		echo "Tree: OK — $HDR_TREE matches the live working tree"
	elif [ "$HDR_TREE" = "clean" ] && [ "$LIVE_TREE" != "clean" ]; then
		echo "Tree: FAIL — hand-off says 'clean' but the live tree is '$LIVE_TREE' (work moved outside the hand-off's account of it)"
		STOP=1
	else
		echo "Tree: FAIL — hand-off says '$HDR_TREE', live tree is '$LIVE_TREE'"
		STOP=1
	fi
fi

# --- 6. Branch -----------------------------------------------------------
CARD_FILE="$REPO_ROOT/docs/PROGRESS.md"
if [ -z "$HDR_BRANCH" ]; then
	echo "Branch: not checked — no 'Branch:' line in the hand-off header (a hand-off written before the field existed)"
else
	CLAIMED_BRANCH=$(printf '%s\n' "$HDR_BRANCH" | awk '{print $1}' | tr -d '`')
	LIVE_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
	if [ "$CLAIMED_BRANCH" != "$LIVE_BRANCH" ]; then
		echo "Branch: FAIL — hand-off says '$CLAIMED_BRANCH', this checkout is on '$LIVE_BRANCH'"
		STOP=1
	else
		UPSTREAM=$(git rev-parse --abbrev-ref '@{u}' 2>/dev/null)
		if [ -z "$UPSTREAM" ]; then
			echo "Branch: OK — on '$LIVE_BRANCH' (no upstream configured, so the pushed claim cannot be checked)"
		else
			UNPUSHED=$(git rev-list --count '@{u}..HEAD' 2>/dev/null)
			if [ "${UNPUSHED:-0}" -gt 0 ] && printf '%s\n' "$HDR_BRANCH" | grep -qi 'pushed'; then
				echo "Branch: FAIL — hand-off says pushed, but $UNPUSHED commit(s) on '$LIVE_BRANCH' never left this machine ($UPSTREAM..HEAD)"
				STOP=1
			else
				echo "Branch: OK — on '$LIVE_BRANCH', ${UNPUSHED:-0} commit(s) ahead of $UPSTREAM"
			fi
		fi
	fi
fi

# --- Mode — carried, not checked -----------------------------------------
if [ -n "$HDR_MODE" ]; then
	CARD_AUTONOMY=""
	CARD_CHAIN_FOR_MODE=""
	if [ -f "$CARD_FILE" ]; then
		CARD_AUTONOMY=$(grep -m1 -E '^- Autonomy:' "$CARD_FILE" | sed -E 's/^- Autonomy:[[:space:]]*//' | awk '{print $1}')
		CARD_CHAIN_FOR_MODE=$(grep -m1 -E '^- Chaining:' "$CARD_FILE" | sed -E 's/^- Chaining:[[:space:]]*//' | awk '{print $1}')
	fi
	echo "Mode: $HDR_MODE (carried, not checked — the card says Autonomy: ${CARD_AUTONOMY:-unreadable} / Chaining: ${CARD_CHAIN_FOR_MODE:-unreadable}, and the card is the authority)"
else
	echo "Mode: not carried — no 'Mode:' line in the hand-off header; apply the card's Autonomy: and Chaining: values"
fi

echo

if [ "$STOP" -ne 0 ]; then
	echo "VERDICT: STOP"
	exit 1
fi

echo "VERDICT: CONTINUE"

if [ "$MODE" = "no-lane" ]; then
	exit 0
fi

# --- Single-lane lock — claim it, but ONLY if the card says Chaining: start
CARD_CHAINING=""
if [ -f "$CARD_FILE" ]; then
	CARD_CHAINING=$(grep -m1 -E '^- Chaining:' "$CARD_FILE" | sed -E 's/^- Chaining:[[:space:]]*//' | awk '{print $1}')
fi

if [ "$CARD_CHAINING" = "start" ]; then
	echo
	LOCK_FILE=$(lock_file_path)

	# Compute this hand-off's own launch-receipt identity, to check the
	# baton case below (a live lock holder that IS this hand-off's own
	# recorded launcher is not a conflict — the lane is handed over).
	RECEIPT_KEY=$(sha256_of "${HDR_GENERATED}${HDR_COMMIT}")
	RECEIPT_DIR="$STATE_ROOT/keel-receipts/$RECEIPT_KEY"
	LAUNCHER_ID=""
	[ -f "$RECEIPT_DIR/launcher-pid" ] && LAUNCHER_ID=$(cat "$RECEIPT_DIR/launcher-pid" 2>/dev/null)
	# The receipt carries the launcher's session identity ("<pid>-<start>");
	# one written by an older launcher carries the bare PID. Either names it.
	LAUNCHER_PID="${LAUNCHER_ID%%-*}"

	if [ ! -f "$LOCK_FILE" ]; then
		write_lock "$LOCK_FILE"
		echo "Lane claimed for $REPO_ROOT (PID $SELF_PID)."
	else
		RECORDED_PID=$(grep -m1 '^pid=' "$LOCK_FILE" | cut -d= -f2-)
		RECORDED_START=$(grep -m1 '^start_time=' "$LOCK_FILE" | cut -d= -f2-)

		if ! holder_is_live "$RECORDED_PID" "$RECORDED_START"; then
			# Orphan: dead PID, or a live PID whose start time doesn't match
			# (the number was reused by an unrelated process).
			write_lock "$LOCK_FILE"
			echo "Recovered an orphaned lane (was PID $RECORDED_PID) for $REPO_ROOT (PID $SELF_PID)."
		elif [ "$RECORDED_PID" = "$SELF_PID" ]; then
			echo "Lane already held by this session ($SELF_PID) for $REPO_ROOT."
		elif [ -n "$LAUNCHER_PID" ] && [ "$RECORDED_PID" = "$LAUNCHER_PID" ]; then
			# Baton: the live holder is exactly this hand-off's own launcher,
			# which has by definition already closed out.
			write_lock "$LOCK_FILE"
			echo "Baton: lane passed from launcher PID $RECORDED_PID for $REPO_ROOT (PID $SELF_PID)."
		else
			echo "Lane BUSY — $REPO_ROOT is held by a live session (PID $RECORDED_PID, started $RECORDED_START). Close that window, or run 'scripts/keel-handoff-verify --release' inside it, to free the lane."
			exit 1
		fi
	fi
fi

exit 0
