#!/usr/bin/env bash
#
# keel-handoff-verify — the five mechanical courier checks over
# docs/continuation-prompt.md, per Keel's references/project-state.md
# ("The continuation file"). A session NEVER composes these checks inline —
# it always runs this script, because inline `$(...)` nesting breaks the
# permission matcher (see the reference for why).
#
# Checks, in this order (containment first — it is the only one that
# catches a second checkout of the SAME repository):
#   1. Containment — the hand-off file's real path is inside this session's
#      `git rev-parse --show-toplevel`.
#   2. Repo — the header's `Repo:` short hash against this repo's root
#      commit (`git rev-list --max-parents=0 HEAD | sort | head -1`).
#   3. Commit — the header's `Commit:` against `git rev-parse HEAD`.
#      Informational, not necessarily a hard fail if behind: a hand-off
#      naming an ancestor of HEAD just means the repo moved on since it was
#      written, which is normal after further commits in the same session.
#   4. Generated — parses as a valid epoch/timestamp.
#   5. Tree — the header's `Tree:` (clean / dirty (N files)) against the
#      live `git status --porcelain`.
#
# Prints one line per check, then VERDICT: CONTINUE or VERDICT: STOP.
#
# --release: releases the single-lane lock (only meaningful on projects
# whose project card says `Chaining: start` — this project's card says
# `Chaining: off`, so under normal operation there is nothing to release;
# the flag still works cleanly and says so rather than erroring).
#
# A missing docs/continuation-prompt.md is NOT an error: it means resume
# normally from docs/PROGRESS.md (the file is gitignored, so a fresh clone
# never has one).

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
	echo "Not inside a git repository — cannot run the courier checks."
	exit 1
fi
cd "$REPO_ROOT" || exit 1

HANDOFF="$REPO_ROOT/docs/continuation-prompt.md"

# --- Portable epoch helpers (macOS/BSD date vs GNU date) -------------------
iso_to_epoch() {
	# $1: an ISO-8601-ish timestamp, e.g. 2026-07-29T18:40:00+02:00
	local ts="$1"
	# Try GNU date first
	if date -d "$ts" +%s >/dev/null 2>&1; then
		date -d "$ts" +%s
		return 0
	fi
	# BSD/macOS date: strip the colon in the timezone offset (+02:00 -> +0200)
	local ts_bsd
	ts_bsd=$(printf '%s' "$ts" | sed -E 's/([+-][0-9]{2}):([0-9]{2})$/\1\2/')
	if date -j -f "%Y-%m-%dT%H:%M:%S%z" "$ts_bsd" +%s >/dev/null 2>&1; then
		date -j -f "%Y-%m-%dT%H:%M:%S%z" "$ts_bsd" +%s
		return 0
	fi
	return 1
}

file_mtime_epoch() {
	local f="$1"
	if stat -f %m "$f" >/dev/null 2>&1; then
		stat -f %m "$f"
		return 0
	fi
	if stat -c %Y "$f" >/dev/null 2>&1; then
		stat -c %Y "$f"
		return 0
	fi
	return 1
}

# ---------------------------------------------------------------------------
# --release: free the single-lane lock, idempotently. No allow-list entry
# of its own is needed — it shares this script's one entry.
if [ "${1:-}" = "--release" ]; then
	LOCK_DIR="${TMPDIR:-/tmp}/keel-locks"
	# Key: the real repo path, sanitized to a filename.
	KEY=$(printf '%s' "$REPO_ROOT" | shasum -a 256 2>/dev/null | awk '{print $1}')
	if [ -z "$KEY" ]; then
		KEY=$(printf '%s' "$REPO_ROOT" | md5 2>/dev/null || printf '%s' "$REPO_ROOT" | md5sum | awk '{print $1}')
	fi
	LOCK_FILE="$LOCK_DIR/$KEY.lock"
	if [ -f "$LOCK_FILE" ]; then
		HOLDER_PID=$(grep -m1 '^pid=' "$LOCK_FILE" 2>/dev/null | cut -d= -f2)
		THIS_PID=$$
		if [ "$HOLDER_PID" = "$THIS_PID" ] || [ -n "$HOLDER_PID" ]; then
			rm -f "$LOCK_FILE"
			echo "Lane released for $REPO_ROOT (was held by PID $HOLDER_PID)."
		else
			echo "Lock file present but unreadable — removed defensively."
			rm -f "$LOCK_FILE"
		fi
	else
		echo "Nothing to release — no lane held for $REPO_ROOT (this project's Chaining: off, so the lane is normally never taken)."
	fi
	exit 0
fi

# ---------------------------------------------------------------------------
if [ ! -f "$HANDOFF" ]; then
	echo "no docs/continuation-prompt.md — nothing to verify (this is ordinary: the file is gitignored, resume from docs/PROGRESS.md)"
	exit 0
fi

STOP=0

# --- 1. Containment ----------------------------------------------------
REAL_HANDOFF=$(cd "$(dirname "$HANDOFF")" 2>/dev/null && pwd -P)/$(basename "$HANDOFF")
case "$REAL_HANDOFF" in
	"$REPO_ROOT"/*)
		echo "Containment: OK — $HANDOFF is inside $REPO_ROOT"
		;;
	*)
		echo "Containment: FAIL — $HANDOFF resolves outside $REPO_ROOT"
		STOP=1
		;;
esac

# Parse the freshness header (the block between the first two '---' lines).
HEADER=$(awk '/^---$/{n++; next} n==1{print} n>=2{exit}' "$HANDOFF")
HDR_REPO=$(printf '%s\n' "$HEADER" | grep -m1 '^Repo:' | sed -E 's/^Repo:[[:space:]]*//')
HDR_COMMIT=$(printf '%s\n' "$HEADER" | grep -m1 '^Commit:' | sed -E 's/^Commit:[[:space:]]*//')
HDR_GENERATED=$(printf '%s\n' "$HEADER" | grep -m1 '^Generated:' | sed -E 's/^Generated:[[:space:]]*//')
HDR_TREE=$(printf '%s\n' "$HEADER" | grep -m1 '^Tree:' | sed -E 's/^Tree:[[:space:]]*//')

# --- 2. Repo -------------------------------------------------------------
IS_SHALLOW=$(git rev-parse --is-shallow-repository 2>/dev/null)
if [ "$IS_SHALLOW" = "true" ]; then
	if [ "$HDR_REPO" = "unavailable (shallow)" ]; then
		echo "Repo: unavailable (shallow) — identity unverifiable, relying on containment"
	else
		echo "Repo: FAIL — this is a shallow clone but the hand-off does not say 'unavailable (shallow)' (got '$HDR_REPO')"
		STOP=1
	fi
else
	ROOT_COMMIT_FULL=$(git rev-list --max-parents=0 HEAD 2>/dev/null | sort | head -1)
	if [ -z "$HDR_REPO" ]; then
		echo "Repo: FAIL — no 'Repo:' line found in the hand-off header"
		STOP=1
	elif [ -z "$ROOT_COMMIT_FULL" ]; then
		echo "Repo: FAIL — could not determine this repository's root commit"
		STOP=1
	else
		HDR_LEN=${#HDR_REPO}
		ROOT_SHORT="${ROOT_COMMIT_FULL:0:$HDR_LEN}"
		if [ "$HDR_REPO" = "$ROOT_SHORT" ]; then
			echo "Repo: OK — $HDR_REPO matches this repository's root commit"
		else
			echo "Repo: FAIL — hand-off says '$HDR_REPO', this repository's root commit is '$ROOT_SHORT' (this hand-off belongs to another repository)"
			STOP=1
		fi
	fi
fi

# --- 3. Commit (informational — never a hard STOP by itself) -----------
CURRENT_HEAD=$(git rev-parse HEAD 2>/dev/null)
if [ -z "$HDR_COMMIT" ]; then
	echo "Commit: FAIL — no 'Commit:' line found in the hand-off header"
	STOP=1
elif [ -z "$CURRENT_HEAD" ]; then
	echo "Commit: FAIL — could not determine current HEAD"
	STOP=1
else
	# Accept a short-hash prefix match against the current or an ancestor commit.
	if git rev-parse --verify "${HDR_COMMIT}" >/dev/null 2>&1; then
		RESOLVED=$(git rev-parse "${HDR_COMMIT}" 2>/dev/null)
		if [ "$RESOLVED" = "$CURRENT_HEAD" ]; then
			echo "Commit: OK — $HDR_COMMIT is the current HEAD"
		elif git merge-base --is-ancestor "$RESOLVED" "$CURRENT_HEAD" 2>/dev/null; then
			BEHIND=$(git rev-list --count "${RESOLVED}..${CURRENT_HEAD}" 2>/dev/null)
			echo "Commit: OK (informational) — $HDR_COMMIT is $BEHIND commit(s) behind current HEAD ($CURRENT_HEAD); the repo moved on since the hand-off was written"
		else
			echo "Commit: FAIL — $HDR_COMMIT is not an ancestor of current HEAD ($CURRENT_HEAD); histories have diverged"
			STOP=1
		fi
	else
		echo "Commit: FAIL — '$HDR_COMMIT' does not resolve to a commit in this repository"
		STOP=1
	fi
fi

# --- 4. Generated ----------------------------------------------------
if [ -z "$HDR_GENERATED" ]; then
	echo "Generated: FAIL — no 'Generated:' line found in the hand-off header"
	STOP=1
else
	GEN_EPOCH=$(iso_to_epoch "$HDR_GENERATED")
	if [ -z "$GEN_EPOCH" ]; then
		echo "Generated: FAIL — '$HDR_GENERATED' does not parse as a valid timestamp"
		STOP=1
	else
		NOW_EPOCH=$(date +%s)
		MTIME_EPOCH=$(file_mtime_epoch "$HANDOFF")
		AGE=$(( NOW_EPOCH - GEN_EPOCH ))
		echo "Generated: OK — $HDR_GENERATED parses as epoch $GEN_EPOCH (age: ${AGE}s; file mtime epoch: ${MTIME_EPOCH:-unknown})"
	fi
fi

# --- 5. Tree -------------------------------------------------------------
if [ -z "$HDR_TREE" ]; then
	echo "Tree: FAIL — no 'Tree:' line found in the hand-off header"
	STOP=1
else
	PORCELAIN=$(git status --porcelain 2>/dev/null)
	if [ -z "$PORCELAIN" ]; then
		LIVE_TREE="clean"
	else
		N=$(printf '%s\n' "$PORCELAIN" | grep -c .)
		LIVE_TREE="dirty ($N files)"
	fi
	if [ "$HDR_TREE" = "$LIVE_TREE" ]; then
		echo "Tree: OK — $HDR_TREE matches the live working tree"
	elif [ "$HDR_TREE" = "clean" ] && [ "$LIVE_TREE" != "clean" ]; then
		echo "Tree: FAIL — hand-off says 'clean' but the live tree is '$LIVE_TREE' (work moved outside the hand-off's account of it)"
		STOP=1
	else
		echo "Tree: FAIL — hand-off says '$HDR_TREE', live tree is '$LIVE_TREE'"
		STOP=1
	fi
fi

echo
if [ "$STOP" -eq 0 ]; then
	echo "VERDICT: CONTINUE"
	exit 0
else
	echo "VERDICT: STOP"
	exit 1
fi
