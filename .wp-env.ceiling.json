{
	"$schema": "https://raw.githubusercontent.com/WordPress/gutenberg/trunk/schemas/json/wp-env.schema.json",
	"core": "https://wordpress.org/wordpress-7.0.7.zip",
	"phpVersion": "8.3",
	"port": 8890,
	"testsPort": 8891,
	"plugins": [
		"https://downloads.wordpress.org/plugin/woocommerce.10.9.4.zip",
		"."
	],
	"mappings": {
		"wp-content/mu-plugins": "./.wp-env-mu-plugins"
	},
	"config": {
		"AUTOMATIC_UPDATER_DISABLED": true,
		"WP_AUTO_UPDATE_CORE": false,
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true
	},
	"env": {
		"tests": {
			"config": {
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": true
			}
		}
	}
}
