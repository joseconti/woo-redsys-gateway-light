#!/usr/bin/env bash
#
# pre-push — every push runs the affected selection of what is being pushed.
#
# Keel references/test-automation.md, "Which tests run when". For each
# branch being pushed this runs
#   scripts/keel-affected-tests --run --base <remote sha> --head <local sha>
# (a new branch: the merge-base with the integration branch) and refuses the
# push when the selection is red, the selector failed, or the environment
# the selection needs is not running. A tag push is skipped: a tag is a
# release, and its evidence is the full-suite run recorded at the Phase 7
# gate. A branch deletion has nothing to test.
#
# Bypassing this hook with `git push --no-verify` is the user's act, never
# the assistant's.
#
# git passes: $1 = remote name, $2 = remote URL; and on stdin one line per
# ref: <local ref> <local sha> <remote ref> <remote sha>

set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 1
cd "$ROOT" || exit 1

SELECTOR="scripts/keel-affected-tests"
INTEGRATION_BRANCH="develop"
REMOTE="${1:-origin}"

if [ ! -x "$SELECTOR" ]; then
	echo "pre-push: $SELECTOR is missing or not executable — refusing the push (the selection cannot be computed)." >&2
	exit 1
fi

is_zero() {
	case "$1" in
		*[!0]*) return 1 ;;
	esac
	return 0
}

BLOCKED=0

while read -r local_ref local_sha remote_ref remote_sha; do
	[ -z "${local_ref:-}" ] && continue

	case "$remote_ref" in
		refs/tags/*)
			echo "pre-push: $remote_ref is a tag — skipped (a release's evidence is the full-suite run at the Phase 7 gate)."
			continue
			;;
	esac

	if is_zero "$local_sha"; then
		echo "pre-push: $remote_ref is being deleted — nothing to test."
		continue
	fi

	BASE=""
	if is_zero "$remote_sha"; then
		# A new branch: its merge-base with the integration branch.
		for cand in "$REMOTE/$INTEGRATION_BRANCH" "$INTEGRATION_BRANCH"; do
			if git rev-parse -q --verify "$cand^{commit}" >/dev/null 2>&1; then
				BASE=$(git merge-base "$local_sha" "$cand" 2>/dev/null) && break
				BASE=""
			fi
		done
	else
		BASE="$remote_sha"
	fi

	echo "pre-push: $local_ref -> $remote_ref"
	if [ -n "$BASE" ]; then
		"$SELECTOR" --run --base "$BASE" --head "$local_sha" </dev/null
	else
		echo "pre-push: no merge-base with $INTEGRATION_BRANCH for a new branch — running the entire suite."
		"$SELECTOR" --run --full </dev/null
	fi
	STATUS=$?

	case "$STATUS" in
		0) ;;
		1) echo "pre-push: REFUSED — the selection for $remote_ref is RED." >&2; BLOCKED=1 ;;
		2) echo "pre-push: REFUSED — the selector failed for $remote_ref (see above)." >&2; BLOCKED=1 ;;
		3) echo "pre-push: REFUSED — the selection for $remote_ref could not run: the environment it needs is missing (see above). A test that did not run is not a pass." >&2; BLOCKED=1 ;;
		*) echo "pre-push: REFUSED — $SELECTOR exited $STATUS for $remote_ref." >&2; BLOCKED=1 ;;
	esac
done

exit "$BLOCKED"
